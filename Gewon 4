let miniR=null,miniScene=null,miniCam=null,miniGrp=null;
function showMini(d,mesh){const host=document.getElementById('mini');if(!host)return;
if(!miniR){miniR=new THREE.WebGLRenderer({alpha:true,antialias:true});miniR.setPixelRatio(Math.min(devicePixelRatio,2));miniR.setSize(150,150);miniScene=new THREE.Scene();miniCam=new THREE.PerspectiveCamera(38,1,.1,200);miniCam.position.set(0,9,34);miniCam.lookAt(0,0,0);}
miniR.domElement.style.cssText='width:150px;height:150px;display:block';host.appendChild(miniR.domElement);
if(miniGrp)miniScene.remove(miniGrp);miniGrp=new THREE.Group();
miniGrp.add(new THREE.Mesh(mesh.geometry,mesh.material),axes());
if(d.wire)miniGrp.add(new THREE.Mesh(mesh.geometry,new THREE.MeshBasicMaterial({color:d.col[1],transparent:true,opacity:.16,side:THREE.DoubleSide,depthWrite:false})));
if(['graph','cube','icoS'].includes(d.shape))miniGrp.add(dots(mesh.geometry,d.c,1.1));
miniScene.add(miniGrp);}
function flySyms(d){const wide=W()>=768,sx=(mouse.x+1)/2*W(),sy=(1-mouse.y)/2*H();
d.sym.concat(d.sym).forEach((ch,i)=>{const e=document.createElement('div');e.className='fly';e.textContent=ch;e.style.color=d.c;e.style.left=sx+'px';e.style.top=sy+'px';document.body.appendChild(e);
const tx=wide?W()-290+(Math.random()-.5)*300:W()/2+(Math.random()-.5)*W()*.6,ty=H()*.18+Math.random()*H()*.6;
gsap.fromTo(e,{scale:.4,opacity:0,xPercent:-50,yPercent:-50},{keyframes:[{opacity:1,scale:1.4,duration:.25},{x:tx-sx,y:ty-sy,scale:1,duration:1.1,ease:'power2.inOut'},{opacity:0,scale:2,duration:.5}],delay:.15+i*.08,onComplete:()=>e.remove()});});}
addEventListener('resize',()=>{camera.aspect=W()/H();camera.updateProjectionMatrix();renderer.setSize(W(),H());composer.setSize(W(),H());});

// ===== Transitions =====
function warpForward(){state=S.WARP;controls.enabled=false;setHint('');initAudio();sfxEnter();scene1.add(warpLines);
const tl=gsap.timeline();
tl.timeScale(.625);tl.to(camera.position,{x:0,y:0,z:-5,duration:2,ease:'power3.in'},0);
tl.to(camera,{fov:150,duration:2,ease:'power3.in',onUpdate:()=>camera.updateProjectionMatrix()},0);
tl.to(warp,{speed:120,len:10,duration:1.9,ease:'power2.in'},0);
tl.to('#flash',{opacity:1,duration:.2,ease:'none'},1.8);
warpFx(tl);tl.add(()=>{composer.removePass(rp1);composer.insertPass(rp2,0);composer.insertPass(rp3,2);scene2.add(warpLines);camera.position.copy(CAM2);camera.lookAt(0,0,0);controls.target.set(0,0,0);},2);
tl.to('#flash',{opacity:0,duration:1.5,ease:'power2.out'},2.1);
tl.to(camera,{fov:60,duration:1.5,ease:'power2.out',onUpdate:()=>camera.updateProjectionMatrix()},2.1);
tl.to(warp,{speed:0,len:0,duration:1.5,ease:'power2.out'},2.1);
tl.add(()=>{state=S.S2;controls.enabled=true;show('back',1);setHint('CHẠM VÀO MỘT HÀNH TINH');},3.6);}
function warpBackward(){state=S.WARP;controls.enabled=false;show('back',0);setHint('');sfxExit();scene2.add(warpLines);
if(hov){hov.scale.set(1,1,1);hov=null;document.body.style.cursor='default';}
const far=camera.position.clone().normalize().multiplyScalar(200),tl=gsap.timeline();
tl.timeScale(.625);tl.to(camera.position,{x:far.x,y:far.y,z:far.z,duration:2,ease:'power3.in'},0);
tl.to(camera,{fov:150,duration:2,ease:'power3.in',onUpdate:()=>camera.updateProjectionMatrix()},0);
tl.to(warp,{speed:120,len:10,duration:1.9,ease:'power2.in'},0);
tl.to('#flash',{opacity:1,duration:.2,ease:'none'},1.8);
warpFx(tl);tl.add(()=>{composer.removePass(rp2);composer.removePass(rp3);composer.insertPass(rp1,0);scene1.add(warpLines);camera.position.set(0,0,-5);camera.lookAt(0,0,0);controls.target.set(0,0,0);},2);
tl.to('#flash',{opacity:0,duration:1.5,ease:'power2.out'},2.1);
tl.to(camera.position,{x:CAM1.x,y:CAM1.y,z:CAM1.z,duration:2,ease:'power2.out'},2.1);
tl.to(camera,{fov:60,duration:1.5,ease:'power2.out',onUpdate:()=>camera.updateProjectionMatrix()},2.1);
tl.to(warp,{speed:0,len:0,duration:1.5,ease:'power2.out'},2.1);
tl.add(()=>{state=S.S1;controls.enabled=true;setHint('CHẠM VÀO HỐ ĐEN ĐỂ BƯỚC QUA');},4.1);}
function openPanel(mesh){state=S.PANEL;controls.enabled=false;show('back',0);setHint('');sfxOpen();
const box=$('info');box.innerHTML=mesh.userData.d.html;flySyms(mesh.userData.d);showMini(mesh.userData.d,mesh);
const go=()=>{$('panel').classList.remove('translate-x-full');show('close',1);box.querySelectorAll('.fade').forEach((x,i)=>setTimeout(()=>x.classList.add('on'),300+i*450));};
(window.MathJax&&MathJax.typesetPromise?MathJax.typesetPromise([box]).then(go):go());
const tp=new THREE.Vector3();mesh.userData.g.getWorldPosition(tp);
const dir=tp.clone().sub(camera.position).normalize(),wide=W()>=768;
const cp=tp.clone().sub(dir.multiplyScalar(wide?16:22));
if(wide)cp.add(new THREE.Vector3(1,0,0).applyQuaternion(camera.quaternion).multiplyScalar(-8));
gsap.to(camera.position,{x:cp.x,y:cp.y,z:cp.z,duration:1.5,ease:'power3.inOut'});
gsap.to(controls.target,{x:tp.x,y:tp.y,z:tp.z,duration:1.5,ease:'power3.inOut'});}
function closePanel(){sfxClose();show('close',0);document.querySelectorAll('.fade').forEach(x=>x.classList.remove('on'));$('panel').classList.add('translate-x-full');
const a=Math.PI/2,r=CAM2.z;
gsap.to(camera.position,{x:Math.cos(a)*r,y:CAM2.y,z:Math.sin(a)*r,duration:1.5,ease:'power3.inOut'});
gsap.to(controls.target,{x:0,y:0,z:0,duration:1.5,ease:'power3.inOut',onComplete:()=>{state=S.S2;controls.enabled=true;show('back',1);setHint('CHẠM VÀO MỘT HÀNH TINH');}});}

// ===== Loop =====
const clock=new THREE.Clock();
function animate(){requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;

if(state!==S.PANEL){
  const moveSpeed = 45 * dt;
  const forward = new THREE.Vector3();
  camera.getWorldDirection(forward); // Tự do 3D theo hướng nhìn camera
  
  const right = new THREE.Vector3();
  right.crossVectors(forward, camera.up);
  
  const delta = new THREE.Vector3();
  if (moveState.forward) delta.add(forward);
  if (moveState.backward) delta.sub(forward);
  if (moveState.left) delta.sub(right);
  if (moveState.right) delta.add(right);
  if (moveState.up) delta.y += 1;
  if (moveState.down) delta.y -= 1;
  
  if (delta.lengthSq() > 0) {
    delta.normalize().multiplyScalar(moveSpeed);
    camera.position.add(delta);
    controls.target.add(delta);
  }
}

controls.update();
const in1=composer.passes[0]===rp1;
if(in1){disk.rotation.z-=.005;halo.lookAt(camera.position);const p=pGeo.attributes.position.array;
for(let i=0;i<pCount;i++){const k=i*3,x=p[k],z=p[k+2],a=Math.atan2(z,x)+.02;let r=Math.hypot(x,z)-.05;if(r<3.5)r=30;p[k]=Math.cos(a)*r;p[k+2]=Math.sin(a)*r;}pGeo.attributes.position.needsUpdate=true;}
else{
  mats.forEach(m=>m.uniforms.time.value=t);
  beamMats.forEach(m=>m.uniforms.time.value=t);
  planets.forEach(p=>{p.mesh.rotation.y+=.004;p.sg.rotation.y-=.005;p.sg.children.forEach(s=>s.quaternion.copy(camera.quaternion));p.g.position.y=p.base.y+Math.sin(t+p.base.x)*1.5;});
}
updWarp(dt);composer.render();if(miniGrp&&state===S.PANEL){miniGrp.rotation.y+=.012;miniR.render(miniScene,miniCam);}}
window.onload=animate;
</script>
</body>
</html>
