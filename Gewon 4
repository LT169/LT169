  if (state === S.PANEL) return;
  const k = e.key.toLowerCase();
  if (k === 'w' || e.key === 'ArrowUp') moveState.forward = false;
  if (k === 's' || e.key === 'ArrowDown') moveState.backward = false;
  if (k === 'a' || e.key === 'ArrowLeft') moveState.left = false;
  if (k === 'd' || e.key === 'ArrowRight') moveState.right = false;
  if (k === ' ' || k === 'e') moveState.up = false;
  if (k === 'shift' || k === 'q') moveState.down = false;
});

let isMouseDown = false, prevMousePos = { x: 0, y: 0 };
window.addEventListener('mousedown', e => {
  if (state === S.PANEL) return;
  isMouseDown = true;
  prevMousePos = { x: e.clientX, y: e.clientY };
});
window.addEventListener('mouseup', () => { isMouseDown = false; });
window.addEventListener('mousemove', e => {
  if (!isMouseDown || state === S.PANEL || state === S.WARP) return;
  const dx = e.clientX - prevMousePos.x;
  const dy = e.clientY - prevMousePos.y;
  prevMousePos = { x: e.clientX, y: e.clientY };
  
  const rotSpeed = 0.003;
  const offset = camera.position.clone().sub(controls.target);
  let radius = offset.length();
  let theta = Math.atan2(offset.x, offset.z);
  let phi = Math.acos(Math.max(-1, Math.min(1, offset.y / radius)));
  
  theta -= dx * rotSpeed;
  phi -= dy * rotSpeed;
  phi = Math.max(0.01, Math.min(Math.PI - 0.01, phi));
  
  offset.x = radius * Math.sin(phi) * Math.sin(theta);
  offset.y = radius * Math.cos(phi);
  offset.z = radius * Math.sin(phi) * Math.cos(theta);
  
  camera.position.copy(controls.target).add(offset);
  camera.lookAt(controls.target);
});

