  if (state === S.PANEL) return;
  const k = e.key.toLowerCase();
  if (k === 'w' || e.key === 'ArrowUp') moveState.forward = true;
  if (k === 's' || e.key === 'ArrowDown') moveState.backward = true;
  if (k === 'a' || e.key === 'ArrowLeft') moveState.left = true;
  if (k === 'd' || e.key === 'ArrowRight') moveState.right = true;
  if (k === ' ' || k === 'e') moveState.up = true;
  if (k === 'shift' || k === 'q') moveState.down = true;
});
