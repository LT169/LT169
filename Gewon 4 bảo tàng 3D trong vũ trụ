function logoTelegram(){const P=[[-4.8,.2],[4.4,3.8],[2.8,-3.8],[-.4,-1.2],[-1.4,-3.6],[-1.8,-.6]];return ext(disc(6.6,poly(P,.95,THREE.Path)),1.2,.22);}
function logoChrome(){const L=[];for(let i=0;i<3;i++){const a=Math.PI*.5+i*Math.PI*2/3+.08;L.push(ext(ringS(6.4,3.4,a,a+Math.PI*2/3-.16),1.0,.15));}
