function logoLlama(){const s=new THREE.Shape(),P=[[-2.7,-6.2],[-1.9,.6],[-2.4,5.8],[-.9,3],[.6,6.4],[1.2,2.9],[3.7,1.1],[5.2,-.1],[5.4,-1.2],[4.1,-2],[2,-1.6],[2.5,-6.2]];
