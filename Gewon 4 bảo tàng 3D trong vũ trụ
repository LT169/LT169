const savedTargetPos = new THREE.Vector3();

function openPanel(mesh){
state=S.PANEL; controls.enabled=false; show('back',0); sfxOpen();
savedCamPos.copy(camera.position);
savedTargetPos.copy(controls.target);

const box=$('info');box.innerHTML=mesh.userData.d.html;flySyms(mesh.userData.d);showMini(mesh.userData.d,mesh);
const go=()=>{$('panel').classList.remove('translate-x-full');show('close',1);box.querySelectorAll('.fade').forEach((x,i)=>setTimeout(()=>x.classList.add('on'),300+i*450));};
(window.MathJax&&MathJax.typesetPromise?MathJax.typesetPromise([box]).then(go):go());
const tp=new THREE.Vector3();mesh.userData.g.getWorldPosition(tp);
const dir=tp.clone().sub(camera.position).normalize(),wide=W()>=768;
const cp=tp.clone().sub(dir.multiplyScalar(wide?14:18));
if(wide)cp.add(new THREE.Vector3(1,0,0).applyQuaternion(camera.quaternion).multiplyScalar(-6));
gsap.to(camera.position,{x:cp.x,y:cp.y,z:cp.z,duration:1.5,ease:'power3.inOut'});
gsap.to(controls.target,{x:tp.x,y:tp.y,z:tp.z,duration:1.5,ease:'power3.inOut'});}

function closePanel(){
sfxClose(); show('close',0); document.querySelectorAll('.fade').forEach(x=>x.classList.remove('on')); $('panel').classList.add('translate-x-full');
gsap.to(camera.position,{x:savedCamPos.x, y:savedCamPos.y, z:savedCamPos.z, duration:1.5, ease:'power3.inOut'});
gsap.to(controls.target,{x:savedTargetPos.x, y:savedTargetPos.y, z:savedTargetPos.z, duration:1.5, ease:'power3.inOut', onComplete:()=>{state=S.S2;controls.enabled=true;show('back',1);}});
}

// ===== Loop & Walkthrough Movement =====
const clock=new THREE.Clock();
function animate(){requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;

if(state===S.S2){
  const moveSpeed = 30 * dt;
  const forward = new THREE.Vector3();
  camera.getWorldDirection(forward);
  forward.y = 0;
  forward.normalize();
  
  const right = new THREE.Vector3();
  right.crossVectors(forward, camera.up);
  
  const delta = new THREE.Vector3();
  if (moveState.forward) delta.add(forward);
  if (moveState.backward) delta.sub(forward);
  if (moveState.left) delta.sub(right);
  if (moveState.right) delta.add(right);
  
  if (delta.lengthSq() > 0) {
    delta.normalize().multiplyScalar(moveSpeed);
    camera.position.add(delta);
    controls.target.add(delta);
  }

  const vertSpeed = 20 * dt;
  if (moveState.up) { camera.position.y += vertSpeed; controls.target.y += vertSpeed; }
  if (moveState.down) { camera.position.y -= vertSpeed; controls.target.y -= vertSpeed; }
}

controls.update();
const in1=composer.passes[0]===rp1;
if(in1){disk.rotation.z-=.005;halo.lookAt(camera.position);const p=pGeo.attributes.position.array;
for(let i=0;i<pCount;i++){const k=i*3,x=p[k],z=p[k+2],a=Math.atan2(z,x)+.02;let r=Math.hypot(x,z)-.05;if(r<3.5)r=30;p[k]=Math.cos(a)*r;p[k+2]=Math.sin(a)*r;}pGeo.attributes.position.needsUpdate=true;}
else{
  mats.forEach(m=>m.uniforms.time.value=t);
  beamMats.forEach(m=>m.uniforms.time.value=t);
  floorMat.uniforms.time.value=t;
  planets.forEach(p=>{if(p.mesh.userData.d.logo)p.mesh.rotation.y=Math.sin(t*.7+p.base.x)*.8;else p.mesh.rotation.y+=.004;p.sg.rotation.y-=.005;p.sg.children.forEach(s=>s.quaternion.copy(camera.quaternion));p.g.position.y=p.base.y+Math.sin(t+p.base.x)*1.5;
  if(p.sparks){const h=p.mesh.material.uniforms.hover.value;p.sparks.material.opacity=h;if(h>.01){const ph=p.sparks.userData.ph,a=p.sparks.geometry.attributes.position.array;for(let i=0;i<ph.length;i++){const q=ph[i];q.a+=q.s*.025;const k=i*3;a[k]=Math.cos(q.a)*q.r;a[k+1]=q.y+Math.sin(t*q.s*2+i)*.8;a[k+2]=Math.sin(q.a)*q.r;}p.sparks.geometry.attributes.position.needsUpdate=true;}}
  });
}
updWarp(dt);composer.render();if(miniGrp&&state===S.PANEL){if(miniGrp.userData.logo)miniGrp.rotation.y=Math.sin(t*.8)*.7;else miniGrp.rotation.y+=.012;miniR.render(miniScene,miniCam);}}
window.onload=animate;
</script>
</body>
</html>
