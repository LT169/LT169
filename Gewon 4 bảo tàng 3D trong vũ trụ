let T0=0,K=1;let ac,master,bus,wet,sh,muted=false;
function initAudio(){
if(ac){if(ac.state==='suspended')ac.resume();return;}
ac=new(window.AudioContext||window.webkitAudioContext)();
master=ac.createGain();master.gain.value=muted?0:1.2;bus=ac.createGain();
const comp=ac.createDynamicsCompressor();comp.threshold.value=-6;comp.knee.value=10;comp.ratio.value=4;comp.attack.value=.003;comp.release.value=.25;
const lp=ac.createBiquadFilter();lp.type='lowpass';lp.frequency.value=2200;lp.Q.value=.6;
bus.connect(master).connect(lp).connect(comp).connect(ac.destination);
const L=ac.sampleRate*2.0,ir=ac.createBuffer(2,L,ac.sampleRate);
for(let c=0;c<2;c++){const d=ir.getChannelData(c);for(let i=0;i<L;i++)d[i]=(d[i-1]||0)*.88+(Math.random()*2-1)*Math.pow(1-i/L,3)*.12;}
const cv=ac.createConvolver();cv.buffer=ir;wet=ac.createGain();wet.gain.value=.4;wet.connect(cv).connect(bus);
sh=ac.createWaveShaper();const n=2048,cr=new Float32Array(n);for(let i=0;i<n;i++)cr[i]=Math.tanh((i/(n-1)*2-1)*3.0);sh.curve=cr;sh.oversample='2x';
const post=ac.createGain();post.gain.value=1.5;sh.connect(post).connect(bus);
ambient();}
function out(n,send){n.connect(bus);const s=ac.createGain();s.gain.value=send;n.connect(s).connect(wet);}
function osc(type,f0,f1,t,d,g,send,rise,det,dr){t=T0+(t-T0)*K;d*=K;const o=ac.createOscillator(),a=ac.createGain();o.type=type;o.detune.value=det||0;
o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(f1,t+d);
if(rise){a.gain.setValueAtTime(.0001,t);a.gain.exponentialRampToValueAtTime(g,t+d);a.gain.linearRampToValueAtTime(.0001,t+d+.3);}
else{a.gain.setValueAtTime(.0001,t);a.gain.linearRampToValueAtTime(g,t+.01);a.gain.exponentialRampToValueAtTime(.0001,t+d);}
o.connect(a);if(dr){a.connect(sh);const s=ac.createGain();s.gain.value=send*.3;a.connect(s).connect(wet);}else out(a,send);
o.start(t);o.stop(t+d+.4);}

function voidCut(t,from,to){from*=K;to*=K;bus.gain.cancelScheduledValues(t+from-.09);bus.gain.setValueAtTime(1,t+from-.07);bus.gain.linearRampToValueAtTime(.0001,t+from);bus.gain.setValueAtTime(.0001,t+to);bus.gain.linearRampToValueAtTime(1,t+to+.1);}
function blast(t,s){osc('sine',80,35,t,3.2,1.1*s,.5);osc('sine',160,70,t,2.8,.7*s,.4);osc('sine',240,120,t,2.5,.45*s,.5);osc('sine',320,160,t,2.5,.35*s,.5);osc('sine',40,30,t+.15,3.0,.9*s,.3);}
function stutter(t,n,span,g){for(let i=0;i<n;i++){const f=120+Math.random()*450;osc('sine',f,f*.5,t+i*span/n,.08,g,.3);}}
function ambient(){
[[73.4,.04],[110,.03],[146.8,.025],[185,.018],[277.2,.01]].forEach(([f,v],i)=>{const o=ac.createOscillator(),g=ac.createGain(),l=ac.createOscillator(),lg=ac.createGain();
o.frequency.value=f;g.gain.value=v;l.frequency.value=.03+i*.015;lg.gain.value=v*.5;l.connect(lg).connect(g.gain);o.connect(g);out(g,.25);o.start();l.start();});
(function pulse(){if(ac&&ac.state==='running'){const t=ac.currentTime;T0=t;K=1;osc('sine',73.4,48,t,3.5,.06,.4);}setTimeout(pulse,8000+Math.random()*5000);})();
}

