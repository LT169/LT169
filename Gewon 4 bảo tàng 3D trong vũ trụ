function disc(R,hole){const s=new THREE.Shape();s.absarc(0,0,R,0,Math.PI*2,false);if(hole)s.holes.push(hole);return s;}
function poly(P,k,PathCls){const s=new PathCls();P.forEach((q,i)=>{i?s.lineTo(q[0]*k,q[1]*k):s.moveTo(q[0]*k,q[1]*k);});s.closePath();return s;}
function ringS(R,r,a0,a1){const s=new THREE.Shape();s.absarc(0,0,R,a0,a1,false);s.absarc(0,0,r,a1,a0,true);s.closePath();return s;}
