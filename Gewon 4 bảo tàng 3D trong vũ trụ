const fs=`uniform float hover;uniform float time;uniform vec3 color1;uniform vec3 color2;varying vec2 vUv;varying vec3 vPosition;
float mod289(float x){return x-floor(x*(1./289.))*289.;}vec4 mod289(vec4 x){return x-floor(x*(1./289.))*289.;}vec4 perm(vec4 x){return mod289(((x*34.)+1.)*x);}
float noise(vec3 p){vec3 a=floor(p);vec3 d=p-a;d=d*d*(3.-2.*d);vec4 b=a.xxyy+vec4(0.,1.,0.,1.);vec4 k1=perm(b.xyxy);vec4 k2=perm(k1.xyxy+b.zzww);vec4 c=k2+a.zzzz;vec4 k3=perm(c);vec4 k4=perm(c+1.);vec4 o1=fract(k3*(1./41.));vec4 o2=fract(k4*(1./41.));vec4 o3=o2*d.z+o1*(1.-d.z);vec2 o4=o3.yw*d.x+o3.xz*(1.-d.x);return o4.y*d.y+o4.x*(1.-d.y);}
void main(){float n=noise(vPosition*.5+time*.2);float m=sin(vUv.x*3.14+time*.5)*cos(vUv.y*3.14-time*.3)+n;m=smoothstep(-.5,1.5,m);vec3 c=mix(color1,color2,m);float rim=1.-max(dot(normalize(vPosition),vec3(0.,0.,1.)),0.);c+=vec3(smoothstep(.6,1.,rim)*.3);float sw=vPosition.x*.07+vPosition.y*.07-time*.9;c+=vec3(smoothstep(.14,0.,abs(fract(sw)-.5))*.85)*hover;c+=vec3(.12)*hover;gl_FragColor=vec4(c*.9,1.);}`;

