  orders.splice(idx, 1);
  saveOrders(orders);
  ensureChatOpen();
  addMsg(`❌ Đơn hàng ${code} đã được hủy và xóa khỏi danh sách.\n\n📌 Lưu ý: Nếu đã thanh toán, khoản hoàn tiền sẽ được xử lý trong 3-5 ngày làm việc. Bạn có thể đặt lại bất cứ lúc nào! 🍋`, 'bot');
  renderOrders();
  updateOrderBadge();
}

