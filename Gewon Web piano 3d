  {icon:'✓', label:'Đã xác nhận'},{icon:'📦', label:'Chuẩn bị hàng'},
  {icon:'🚚', label:'Đang giao'},{icon:'🏠', label:'Đã giao', full:'Đã giao thành công đến bạn'}
];
const DELIVER_AFTER_MS = 30000; /* 30 giây sau khi báo "Đang giao" thì chuyển sang "Đã giao thành công" */

function stepFullLabel(st){ const x = ORDER_STEPS[st]; return x.full || x.label; }

function gwEsc(t){ return String(t == null ? '' : t).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function autoDeliverOrders(){
  const orders = getOrders();
  let changed = false;
  const delivered = [];
  const now = Date.now();
  orders.forEach(o => {
    if((o.status ?? 2) !== 2) return;
    if(!o.shipAt){ o.shipAt = now; changed = true; return; }
    if(now - o.shipAt >= DELIVER_AFTER_MS){
      o.status = 3; o.deliveredAt = now; changed = true;
      if(!o.notified){ o.notified = true; delivered.push(o); }
    }
  });
  if(changed){
    saveOrders(orders);
    if(typeof currentView !== 'undefined' && currentView === 'orders') renderOrders();
  }
  /* Chat AI thông báo đơn đã giao thành công (mỗi đơn chỉ báo 1 lần) */
  delivered.forEach(o => { try{ notifyDeliveredInChat(o); }catch(e){ console.warn(e); } });
}

function notifyDeliveredInChat(o){
  if(typeof ensureChatOpen !== 'function' || typeof addRichMsg !== 'function') return;
  ensureChatOpen();
  const prod = o.product ? ' (' + o.product.name + ')' : '';
  const code = gwEsc(o.code).replace(/'/g, '');
  const html = `<div class="dv-title">🎉 Giao hàng thành công!</div>
    <div class="dv-text">Đơn hàng ${gwEsc(o.code)}${gwEsc(prod)} đã được giao thành công đến ${gwEsc(o.name || 'bạn')}.\nCảm ơn bạn đã tin tưởng Gewon Music 🎵 Chúc bạn chơi nhạc thật vui nhé!</div>
    <div class="dv-actions">
      <button class="dv-btn" onclick="go('orders')">📦 Xem đơn hàng</button>
      <button class="dv-btn danger" onclick="confirmDeleteOrders('one','${code}')">🗑 Xoá khỏi lịch sử</button>
    </div>`;
  addRichMsg(html, 'bot delivered');
}
