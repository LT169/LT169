const ORDER_KEY = 'gewon_orders_v1';
const SEED_FLAG = 'gewon_seeded_v1';
let _ordersCache = null, _seedChecked = false;

const DELETED_KEY = 'gewon_deleted_orders_v1';
function getDeletedCodes(){
  try{ const a = JSON.parse(localStorage.getItem(DELETED_KEY) || '[]'); return Array.isArray(a) ? a : []; }
  catch(e){ return []; }
}
function rememberDeletedCodes(codes){
  try{ localStorage.setItem(DELETED_KEY, JSON.stringify(Array.from(new Set(getDeletedCodes().concat(codes))))); }catch(e){}
}
function dropDeleted(list){
  const del = getDeletedCodes();
  return del.length ? list.filter(o => !del.includes(o.code)) : list;
}

function getOrders(){
  if(_ordersCache !== null) return _ordersCache;
  try{ _ordersCache = JSON.parse(localStorage.getItem(ORDER_KEY) || '[]'); if(!Array.isArray(_ordersCache)) _ordersCache = []; }
  catch(e){ _ordersCache = []; }
  _ordersCache = dropDeleted(_ordersCache);
  return _ordersCache;
}

function saveOrders(list){
  _ordersCache = Array.isArray(list) ? dropDeleted(list) : [];
  try{ localStorage.setItem(ORDER_KEY, JSON.stringify(_ordersCache)); }catch(e){}
  updateOrderBadge();
}

