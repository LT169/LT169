  dealsPage = Math.min(Math.max(1,dealsPage),pages);
  const start=(dealsPage-1)*CATALOG_PAGE_SIZE;
  grid.innerHTML = items.slice(start,start+CATALOG_PAGE_SIZE).map(([id,p])=>cardHTML(p,id)).join('');
  const pagination=document.getElementById('deals-pagination');
