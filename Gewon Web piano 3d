<style id="chanh-chat-eye-motion">
  /* Gentle motion for ChanhNgot's existing eye icon; artwork itself stays unchanged. */
  #chat-btn {
    isolation: isolate;
    border: 1px solid rgba(122, 226, 255, .45);
  }
  #chat-btn::before {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    padding: 2px;
    background: conic-gradient(from 0deg, transparent 0 22%, rgba(80, 220, 255, .95) 31%, rgba(139, 126, 255, .92) 43%, transparent 56% 72%, rgba(88, 220, 255, .7) 82%, transparent 91%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 0;
    animation: chanhEyeOrbit 5.5s linear infinite;
    opacity: .92;
  }
  #chat-btn::after {
    content: "";
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(83, 214, 255, .36);
    box-shadow: 0 0 14px rgba(61, 203, 255, .2), inset 0 0 12px rgba(61, 203, 255, .08);
    pointer-events: none;
    z-index: 0;
    animation: chanhEyeHalo 2.8s ease-in-out infinite;
  }
  #chat-btn .chat-eye-icon {
    position: relative;
    z-index: 1;
    transform-origin: center;
    animation: chanhEyeBreathe 3.8s ease-in-out infinite;
    will-change: transform, filter;
  }
  #chat-btn .chat-badge { z-index: 3; }
  .chat-avatar { isolation: isolate; }
  .chat-avatar::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgba(83, 214, 255, .4);
    box-shadow: 0 0 12px rgba(61, 203, 255, .2);
    pointer-events: none;
    z-index: 1;
    animation: chanhAvatarGlow 3s ease-in-out infinite;
  }
  .chat-avatar .chat-eye-icon {
    animation: chanhAvatarBreathe 4s ease-in-out infinite;
    will-change: transform, filter;
  }
  @keyframes chanhEyeOrbit { to { transform: rotate(360deg); } }
  @keyframes chanhEyeHalo {
    0%, 100% { transform: scale(.97); opacity: .42; }
    50% { transform: scale(1.07); opacity: .95; }
  }
  @keyframes chanhEyeBreathe {
    0%, 100% { transform: scale(.985); filter: brightness(1) saturate(1); }
    50% { transform: scale(1.035); filter: brightness(1.12) saturate(1.08); }
  }
  @keyframes chanhAvatarGlow {
    0%, 100% { opacity: .38; transform: scale(.98); }
    50% { opacity: .9; transform: scale(1.08); }
  }
  @keyframes chanhAvatarBreathe {
    0%, 100% { transform: scale(1); filter: brightness(1); }
    50% { transform: scale(1.035); filter: brightness(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    #chat-btn::before, #chat-btn::after, #chat-btn .chat-eye-icon,
    .chat-avatar::before, .chat-avatar .chat-eye-icon { animation: none !important; }
  }
</style>

</head>
