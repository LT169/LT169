function productThumbURL(src, width=480){
  try {
    const u = new URL(src, location.href);
    if (u.hostname === 'images.unsplash.com') {
      u.searchParams.set('auto','format');
      u.searchParams.set('fit','crop');
      u.searchParams.set('w', String(width));
      u.searchParams.set('q', width <= 200 ? '58' : '68');
      return u.href;
    }
  } catch(e) {}
  return src;
}

function cardHTML(p, id){
  const thumb = productThumbURL(p.images[0], 480);
  return `<article class="product-card" onclick="openDetail('${id}')" tabindex="0" role="link" aria-label="Xem ${p.name}" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openDetail('${id}')}">
    <div class="product-img-wrap">
      <img src="${thumb}" alt="${p.name}" loading="lazy" decoding="async" width="480" height="480" fetchpriority="low" onerror="imgFail(this)">
      ${p.old ? '<span class="product-badge sale">ƯU ĐÃI</span>' : ''}
