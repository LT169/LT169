    </div>
    <div class="product-info">
      <p class="product-brand-mini">${p.brand} <span aria-hidden="true">·</span> ${p.cat==='piano'?'PIANO':p.cat==='guitar'?'GUITAR':'TRỐNG'}</p>
      <h3>${p.name}</h3>
      <div class="price">${p.price}${p.old ? `<span class="price-old">${p.old}</span>` : ''}</div>
    </div>
  </article>`;
}

