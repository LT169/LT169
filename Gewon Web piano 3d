function confirmDeleteOrders(mode, code){
  const orders = getOrders();
  let targets;
  if(mode === 'one'){
    targets = orders.filter(o => o.code === code && (o.status ?? 2) >= 3);
  } else {
    targets = orders.filter(o => (o.status ?? 2) >= 3);
  }
  if(!targets.length){ alert('Không có đơn hàng đã giao nào để xoá.'); return; }
  const old = document.getElementById('cancel-modal');
  if(old) old.remove();
  const overlay = document.createElement('div');
  overlay.id = 'cancel-modal';
  const title = mode === 'one' ? 'Xoá đơn ' + gwEsc(targets[0].code) + '?' : 'Xoá ' + targets.length + ' đơn đã giao?';
  overlay.innerHTML = `<div class="cancel-modal-box">
    <div class="cancel-modal-icon">🗑</div>
    <h3>${title}</h3>
    <p>${mode === 'one' ? 'Đơn hàng này' : 'Toàn bộ lịch sử đơn đã giao'} sẽ bị <strong>XOÁ</strong> khỏi danh sách. Các đơn đang giao không bị ảnh hưởng. Không thể hoàn tác.</p>
    <div class="cancel-modal-actions">
      <button class="btn btn-ghost" id="del-no">Giữ lại</button>
      <button class="btn btn-primary" id="del-yes" style="background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:#fff">Có, xoá</button>
    </div>
  </div>`;
  document.body.appendChild(overlay);
  document.getElementById('del-no').onclick = () => overlay.remove();
  document.getElementById('del-yes').onclick = () => { overlay.remove(); doDeleteOrders(targets.map(o => o.code)); };
  overlay.onclick = (e) => { if(e.target === overlay) overlay.remove(); };
