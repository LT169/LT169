function doDeleteOrders(codes){
  const set = new Set(codes);
  const orders = getOrders();
  /* chỉ xoá đơn đã giao, không đụng tới đơn đang giao */
  const removable = orders.filter(o => set.has(o.code) && (o.status ?? 2) >= 3).map(o => o.code);
  if(!removable.length) return;
  rememberDeletedCodes(removable);
  saveOrders(orders.filter(o => !removable.includes(o.code)));
  renderOrders();
  updateOrderBadge();
  ensureChatOpen();
  addMsg(removable.length === 1
    ? `🗑 Đã xoá đơn hàng ${removable[0]} khỏi lịch sử.`
    : `🗑 Đã xoá ${removable.length} đơn hàng đã giao khỏi lịch sử đơn hàng.`, 'bot');
}

async function doCancelOrder(code){
  const orders = getOrders();
  const idx = orders.findIndex(o => o.code === code);
  if(idx === -1) return;
  if (window.GewonBackend && window.GewonBackend.ready && typeof window.GewonBackend.requestCancellation === 'function') {
    const cloudCancelled = await window.GewonBackend.requestCancellation({code: orders[idx].code, phone: orders[idx].phone});
    if (!cloudCancelled) return;
