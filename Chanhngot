const nebulaVert = `
  varying vec2 vUv;
  void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }
`;
const nebulaFrag = `
  precision highp float;
  uniform float uTime;
  uniform vec3 uColorA;
  uniform vec3 uColorB;
  uniform float uSeed;
  varying vec2 vUv;
  float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p){
    vec2 i = floor(p), f = fract(p);
    f = f*f*(3.0-2.0*f);
    return mix(mix(hash(i), hash(i+vec2(1.0,0.0)), f.x),
               mix(hash(i+vec2(0.0,1.0)), hash(i+vec2(1.0,1.0)), f.x), f.y);
  }
  float fbm(vec2 p){
    float v=0.0, a=0.5;
    for (int i=0;i<6;i++){ v += a*noise(p); p*=2.03; a*=0.5; }
    return v;
  }
  void main(){
    vec2 p = vUv - 0.5;
    float d = length(p)*2.0;
    float radial = 1.0 - smoothstep(0.3, 1.0, d);
    vec2 q = vUv*4.0 + uSeed;
    float n1 = fbm(q + uTime*0.02);
    float n2 = fbm(q*2.5 - uTime*0.03);
    float n3 = fbm(q*5.0 + uTime*0.04);
    float n = n1*0.55 + n2*0.30 + n3*0.15;
    float intensity = pow(n, 1.6) * radial;
    vec3 color = mix(uColorA, uColorB, n);
    gl_FragColor = vec4(color * intensity * 2.0, intensity);
  }
`;
