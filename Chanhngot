function makeGalaxyTexture(){
  const size = 256;
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  const cx = size/2, cy = size/2;
  const core = ctx.createRadialGradient(cx, cy, 0, cx, cy, size*0.35);
  core.addColorStop(0, 'rgba(255,255,255,1)');
  core.addColorStop(0.3, 'rgba(200,230,255,0.7)');
  core.addColorStop(0.7, 'rgba(80,140,220,0.15)');
  core.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = core; ctx.fillRect(0,0,size,size);
  for (let arm = 0; arm < 2; arm++){
    const baseAngle = arm * Math.PI;
    for (let i = 0; i < 400; i++){
      const t = i / 400;
      const angle = baseAngle + t * Math.PI * 2.2;
      const r = t * size * 0.42;
      const x = cx + Math.cos(angle) * r;
      const y = cy + Math.sin(angle) * r;
      const sz = (1 - t*0.7) * 6 + Math.random() * 3;
      const alpha = (1 - t) * 0.5;
      const g = ctx.createRadialGradient(x, y, 0, x, y, sz);
      g.addColorStop(0, `rgba(200,225,255,${alpha})`);
      g.addColorStop(1, 'rgba(80,140,220,0)');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(x, y, sz, 0, Math.PI*2); ctx.fill();
    }
  }
  return new THREE.CanvasTexture(c);
}
