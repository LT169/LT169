    dragStartX = p.clientX; dragStartY = p.clientY;
    dragStartYaw = targetYaw; dragStartPitch = targetPitch;
  }
}

function onMove(e){
  const p = e.touches ? e.touches[0] : e;

  // Đo khoảng di chuyển để phân biệt click vs drag
  if (isDragging){
    if (Math.abs(p.clientX - mouseDownX) > 5 || Math.abs(p.clientY - mouseDownY) > 5){
      mouseMoved = true;
    }
  }

  // Hover raycast khi không kéo
  if (!isDragging && STATE === 'quasar'){
    const nowHover = checkBlackHoleHover(p.clientX, p.clientY);
    if (nowHover !== hoverBlackHole){
      hoverBlackHole = nowHover;
      renderer.domElement.classList.toggle('hover-bh', nowHover);
      hintBar.classList.toggle('hover', nowHover);
    }
  }

  if (!isDragging) return;

  const dx = p.clientX - dragStartX;
  const dy = p.clientY - dragStartY;

  if (STATE === 'quasar'){
    camStateA.theta = dragStartTheta + dx * 0.006;
    camStateA.phi = Math.max(-1.45, Math.min(1.45, dragStartPhi + dy * 0.006));
  } else if (STATE === 'space'){
    targetYaw = dragStartYaw - dx * 0.004;
    targetPitch = Math.max(-0.7, Math.min(0.7, dragStartPitch - dy * 0.004));
  }
}

function onUp(e){
  if (!isDragging) return;
  const wasMoved = mouseMoved;
  isDragging = false;

  // ★ Click (không drag) trên hố đen → warp
  if (!wasMoved && STATE === 'quasar'){
    const p = e.changedTouches ? e.changedTouches[0] : e;
    if (p && checkBlackHoleHover(p.clientX, p.clientY)){
      startWarp();
      return;
    }
  }

  // Nếu vừa kéo xong ở quasar → resume tour sau 3s
  if (STATE === 'quasar' && wasMoved && btnPlay.dataset.wasPlaying === '1'){
    setTimeout(() => {
      if (!isDragging && STATE === 'quasar' && btnPlay.dataset.wasPlaying === '1'){
        tourPlaying = true;
        updatePlayIcon();
        goToShot((currentShotIndex + 1) % SHOTS.length);
      }
    }, 3000);
  }
}

window.addEventListener('mousedown', onDown);
window.addEventListener('mousemove', onMove);
window.addEventListener('mouseup', onUp);
window.addEventListener('touchstart', onDown, { passive: true });
window.addEventListener('touchmove', onMove, { passive: true });
window.addEventListener('touchend', onUp);

/* ★ ESC để quay về */
window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' || e.key === 'Esc'){
    if (STATE === 'space'){
      startReturn();
    }
  }
});

/* Resize */
window.addEventListener('resize', () => {
  const aspect = window.innerWidth / window.innerHeight;
  cameraA.aspect = aspect; cameraA.updateProjectionMatrix();
  cameraB.aspect = aspect; cameraB.updateProjectionMatrix();
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  composer.setSize(window.innerWidth, window.innerHeight);
  bloomPass.resolution.set(window.innerWidth, window.innerHeight);
  bloomPass.setSize(window.innerWidth, window.innerHeight);
});

/* Recycle helper */
function recycleObject(obj, backZ){
  const a = Math.random() * Math.PI * 2;
  const rr = obj.userData.spreadR || (200 + Math.random()*1200);
  obj.position.x = Math.cos(a) * rr;
  obj.position.y = Math.sin(a) * rr;
  obj.position.z = backZ - Math.random() * 500;
}

/* =========================================================
   ANIMATE
========================================================= */
const clock = new THREE.Clock();

function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  elapsed += dt;
  driftTime += dt;

  /* ---------- QUASAR ---------- */
  if (STATE === 'quasar' || STATE === 'warping' || STATE === 'returning'){
    // Chỉ update animation quasar khi không phải returning (đang ở scene B)
    if (STATE !== 'returning'){
      diskMat.uniforms.uTime.value  = elapsed;
      diskMat2.uniforms.uTime.value = elapsed + 320;
      jetMatA.uniforms.uTime.value  = elapsed;
      jetMatB.uniforms.uTime.value  = elapsed;
      jetWideUp.material.uniforms.uTime.value   = elapsed + 50;
      jetWideDown.material.uniforms.uTime.value = elapsed + 50;

      const pos = particlesA.geometry.attributes.position.array;
      for (let i = 0; i < particleCount; i++){
        const d = pData[i];
        d.angle -= d.speed * dt * 2.2;
        pos[i*3]   = Math.cos(d.angle) * d.r;
        pos[i*3+1] = d.yOff;
        pos[i*3+2] = Math.sin(d.angle) * d.r;
      }
      particlesA.geometry.attributes.position.needsUpdate = true;

      starLayersA.forEach(l => { l.stars.rotation.y += l.speed * dt * 60; });

      applyCameraA();

      const pulse = 1.0 + Math.sin(elapsed * 2.2) * 0.06;
      coreGlow.scale.set(11 * pulse, 11 * pulse, 1);
      pinpoint.scale.set(3.6 * (1 + Math.sin(elapsed * 3.5) * 0.08), 3.6 * (1 + Math.sin(elapsed * 3.5) * 0.08), 1);
      outerHalo.scale.set(26 * (1 + Math.sin(elapsed * 1.4) * 0.04), 26 * (1 + Math.sin(elapsed * 1.4) * 0.04), 1);

      // Pulse ring — gợi ý clickable
      const ringPulse = 1 + Math.sin(elapsed * 2.5) * 0.06;
      pulseRing.scale.setScalar(ringPulse);
      const baseOp = hoverBlackHole ? 0.65 : 0.15;
      pulseRing.material.opacity = baseOp + Math.sin(elapsed * 3) * 0.06;

      if (STATE === 'warping'){
        const k = Math.min((elapsed - warpStartTime) / 1.4, 1);
        bloomPass.strength = 0.55 + (1.6 - 0.55) * k;
      } else {
        bloomPass.strength = 0.55;
      }
    }
  }

  /* ---------- SPACE ---------- */
  if (STATE === 'space' || STATE === 'returning'){
    // Auto cruise chỉ khi space (không khi đang returning)
    if (STATE === 'space' && autoCruise){
      autoCruiseTimer += dt;
      if (autoCruiseTimer > 4){
        autoCruiseTimer = 0;
        if (Math.random() < 0.5 && speedLevel > 0) speedLevel--;
        else if (speedLevel < SPEED_LEVELS.length - 1) speedLevel++;
        targetSpeed = SPEED_LEVELS[speedLevel];
        updateSpeedBars();
      }
    }

    // Không smooth speed khi returning (đã tween bằng GSAP)
    if (STATE !== 'returning'){
      currentSpeed += (targetSpeed - currentSpeed) * 0.04;
    }

    currentYaw   += (targetYaw - currentYaw) * 0.06;
    currentPitch += (targetPitch - currentPitch) * 0.06;
    camRigB.rotation.y = currentYaw;
    camRigB.rotation.x = currentPitch;
    camRigB.rotation.z += ((targetYaw - currentYaw) * 0.15 - camRigB.rotation.z) * 0.05;

    const forwardSpeed = currentSpeed * 45;
    const arr = streaksMesh.geometry.attributes.position.array;
    for (let i = 0; i < STREAK_COUNT; i++){
      const s = streaks[i];
      s.z += forwardSpeed * s.speed * dt;
      if (s.z > 40){
        const a = Math.random() * Math.PI * 2;
        const rr = 5 + Math.random() * 90;
        s.x = Math.cos(a) * rr;
        s.y = Math.sin(a) * rr;
        s.z = -STREAK_RANGE - Math.random() * 100;
      }
      const tailZ = s.z + s.tailLen * (0.4 + currentSpeed * 0.5);
      const idx = i * 6;
      arr[idx]   = s.x; arr[idx+1] = s.y; arr[idx+2] = tailZ;
      arr[idx+3] = s.x; arr[idx+4] = s.y; arr[idx+5] = s.z;
    }
    streaksMesh.geometry.attributes.position.needsUpdate = true;
    streakMat.opacity = 0.5 + Math.min(currentSpeed * 0.4, 0.5);

    galaxies.forEach((g, i) => {
      g.position.z += forwardSpeed * 0.15 * dt;
      if (g.position.z > 100){
        recycleObject(g, -3500);
        const scale = 60 + Math.random()*220;
        g.scale.set(scale, scale, 1);
        g.material.rotation = Math.random() * Math.PI * 2;
      }
      g.material.rotation += dt * 0.02;
      g.material.opacity = 0.7 + Math.sin(elapsed * 0.5 + i) * 0.15;
    });

    nebulaData.forEach(n => {
      n.position.z += forwardSpeed * 0.08 * dt;
      if (n.position.z > 300) recycleObject(n, -3500);
      n.material.uniforms.uTime.value += dt;
      n.quaternion.copy(cameraB.quaternion);
    });

    bgStars.rotation.y += dt * 0.005;

    const targetFov = 70 + currentSpeed * 8;
    cameraB.fov += (targetFov - cameraB.fov) * 0.04;
    cameraB.updateProjectionMatrix();

    if (STATE === 'space'){
      bloomPass.strength = 0.5 + currentSpeed * 0.15;
    }
  }

  composer.render();
}

/* =========================================================
   INIT
========================================================= */
window.addEventListener('load', () => {
  // Streak positions ban đầu
  const arr = streaksMesh.geometry.attributes.position.array;
  for (let i = 0; i < STREAK_COUNT; i++){
    const s = streaks[i];
    const idx = i * 6;
    arr[idx]   = s.x; arr[idx+1] = s.y; arr[idx+2] = s.z + s.tailLen;
    arr[idx+3] = s.x; arr[idx+4] = s.y; arr[idx+5] = s.z;
  }
  streaksMesh.geometry.attributes.position.needsUpdate = true;

  // Camera A vào shot đầu
  camStateA.r = SHOTS[0].r;
  camStateA.phi = SHOTS[0].phi;
  camStateA.theta = SHOTS[0].theta;
  camStateA.fov = SHOTS[0].fov;
  cameraA.fov = SHOTS[0].fov;
  cameraA.updateProjectionMatrix();
  applyCameraA();

  setTimeout(() => {
    const loader = document.getElementById('loader');
    loader.style.opacity = 0;
    setTimeout(() => loader.style.display = 'none', 1000);
    setTimeout(() => goToShot(1, 3.5), 800);
  }, 700);

  animate();
});
</script>
