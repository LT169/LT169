<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quasar ⇄ Cosmos</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#000; }
  #canvas-container { position:fixed; inset:0; }
  canvas { display:block; cursor: grab; }
  canvas:active { cursor: grabbing; }
  canvas.hover-bh { cursor: pointer !important; }

  #grain { position:fixed; inset:0; z-index:5; pointer-events:none;
    opacity: 0.06; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence baseFrequency='0.9'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }

  #flash { position:fixed; inset:0; background:#fff; z-index:50;
    pointer-events:none; opacity:0; }

  #loader { position:fixed; inset:0; background:#000; z-index:100;
    display:flex; align-items:center; justify-content:center; transition: opacity 1s ease; }
  .loader-ring { width:60px; height:60px;
    border:1px solid rgba(150, 200, 255, 0.15); border-top-color:#7dd3fc;
    border-radius:50%; animation: spin 1.4s linear infinite; position:relative;
    box-shadow: 0 0 30px rgba(80, 180, 255, 0.3); }
  .loader-ring::after { content:''; position:absolute; inset:8px;
    border:1px solid rgba(150, 200, 255, 0.15); border-bottom-color:#a0c4ff;
    border-radius:50%; animation: spin 2s linear infinite reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Hint bar — cực mờ, tự fade */
  #hint-bar {
    position:fixed; bottom:22px; left:50%; transform:translateX(-50%);
    font-family:'JetBrains Mono', ui-monospace, monospace; font-size:10px;
    letter-spacing:0.28em; text-transform:uppercase;
    color: rgba(180, 215, 255, 0.35);
    z-index:15; pointer-events:none;
    transition: opacity 1.2s ease, color 0.4s ease;
    white-space: nowrap; opacity:0;
  }
  #hint-bar.show { opacity: 0.55; }
  #hint-bar.dim  { opacity: 0.18; }
  #hint-bar.hover { opacity: 0.9; color: rgba(210, 235, 255, 0.9); }

  /* ==== UI chung ==== */
  .ctrl-btn {
    width:40px; height:40px; border-radius:50%;
    background: rgba(15, 25, 45, 0.55);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(140, 190, 255, 0.18);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition: all .25s ease;
    color: rgba(210, 235, 255, 0.8);
  }
  .ctrl-btn:hover {
    background: rgba(30, 55, 95, 0.7);
    border-color: rgba(140, 190, 255, 0.5);
    color: #ffffff;
    box-shadow: 0 0 22px rgba(80, 170, 255, 0.4);
    transform: scale(1.08);
  }
  .ctrl-btn svg { width:16px; height:16px; display:block; }
  .ctrl-btn.active { border-color: rgba(140, 190, 255, 0.7); color: #7dd3fc;
    box-shadow: 0 0 15px rgba(80, 170, 255, 0.4); }

  /* ==== Quasar UI ==== */
  #quasar-ui { position:fixed; inset:0; z-index:20; pointer-events:none;
    transition: opacity .8s ease; }
  #quasar-ui.hidden { opacity:0; }

  #shots {
    position:absolute; bottom:64px; left:28px;
    display:flex; gap:8px; padding: 14px 18px;
    border-radius: 999px;
    background: rgba(15, 25, 45, 0.4);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(140, 190, 255, 0.12);
    pointer-events:auto;
  }
  .shot-dot {
    width:6px; height:6px; border-radius:50%;
    background: rgba(140, 190, 255, 0.25);
    transition: all .35s ease; cursor:pointer;
  }
  .shot-dot.active { background: #7dd3fc; box-shadow: 0 0 12px #7dd3fc;
    transform: scale(1.4); }
  .shot-dot:hover { background: rgba(140, 190, 255, 0.6); }

  #tour-controls {
    position:absolute; bottom:64px; right:28px;
    display:flex; gap:10px; pointer-events:auto;
  }

  /* ==== Space UI ==== */
  #space-ui {
    position:fixed; bottom:24px; left:50%; transform: translateX(-50%);
    z-index:20; display:flex; gap:10px; align-items:center;
    padding: 12px 18px;
    background: rgba(15, 25, 45, 0.5);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(140, 190, 255, 0.15);
    border-radius: 999px;
    opacity:0; pointer-events:none;
    transition: opacity .8s ease;
  }
  #space-ui.visible { opacity:1; pointer-events:auto; }

  #speed-meter { display:flex; gap:3px; align-items:center; padding: 0 8px; }
  .speed-bar { width:3px; height:14px; border-radius:2px;
    background: rgba(140, 190, 255, 0.15); transition: all .3s ease; }
  .speed-bar.on { background: #7dd3fc; box-shadow: 0 0 8px #7dd3fc; }

  @media (max-width: 640px) {
    #shots { bottom:56px; left:20px; padding:12px 14px; }
    #tour-controls { bottom:56px; right:20px; }
    #space-ui { bottom:20px; padding:10px 14px; gap:6px; }
    .ctrl-btn { width:36px; height:36px; }
    #hint-bar { font-size:9px; letter-spacing:0.2em; bottom:18px; }
  }
</style>
</head>
<body>

<div id="loader"><div class="loader-ring"></div></div>
<div id="canvas-container"></div>
<div id="grain"></div>
<div id="flash"></div>

<div id="hint-bar">click hố đen để vào trong · esc để quay về</div>

<!-- Quasar UI -->
<div id="quasar-ui">
  <div id="shots"></div>
  <div id="tour-controls">
    <button class="ctrl-btn" id="btn-play" title="Play/Pause"></button>
    <button class="ctrl-btn" id="btn-shuffle" title="Shuffle"></button>
  </div>
</div>

<!-- Space UI -->
<div id="space-ui">
  <button class="ctrl-btn" id="btn-slow" title="Slower"></button>
  <div id="speed-meter">
    <div class="speed-bar"></div><div class="speed-bar"></div>
    <div class="speed-bar"></div><div class="speed-bar"></div>
    <div class="speed-bar"></div>
  </div>
  <button class="ctrl-btn" id="btn-fast" title="Faster"></button>
  <button class="ctrl-btn" id="btn-cruise" title="Auto"></button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

<script>
/* =========================================================
   RENDERER / STATE
========================================================= */
const container = document.getElementById('canvas-container');
const renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 0.85;
container.appendChild(renderer.domElement);

let STATE = 'quasar';   // 'quasar' | 'warping' | 'space' | 'returning'
let elapsed = 0;
let warpStartTime = 0;
let returnStartTime = 0;

/* =========================================================
   TEXTURES DÙNG CHUNG
========================================================= */
function makeStarTexture(){
  const c = document.createElement('canvas');
  c.width = c.height = 64;
  const ctx = c.getContext('2d');
  const g = ctx.createRadialGradient(32,32,0, 32,32,32);
  g.addColorStop(0.00, 'rgba(255,255,255,1)');
  g.addColorStop(0.18, 'rgba(230,240,255,0.9)');
  g.addColorStop(0.45, 'rgba(160,200,255,0.25)');
  g.addColorStop(1.00, 'rgba(0,0,0,0)');
  ctx.fillStyle = g; ctx.fillRect(0,0,64,64);
  return new THREE.CanvasTexture(c);
}
const starTex = makeStarTexture();

function makeGlow(size, sharp){
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  const h = size/2;
  const g = ctx.createRadialGradient(h,h,0, h,h,h);
  g.addColorStop(0.00, 'rgba(255,255,255,1)');
  g.addColorStop(sharp, 'rgba(230,248,255,0.95)');
  g.addColorStop(0.22, 'rgba(140,215,255,0.55)');
  g.addColorStop(0.45, 'rgba(70,150,235,0.18)');
  g.addColorStop(0.75, 'rgba(20,60,140,0.04)');
  g.addColorStop(1.00, 'rgba(0,0,0,0)');
  ctx.fillStyle = g; ctx.fillRect(0,0,size,size);
  return new THREE.CanvasTexture(c);
}
const coreGlowTex = makeGlow(512, 0.10);
const haloGlowTex = makeGlow(512, 0.05);

/* =========================================================
   ============== SCENE A: QUASAR ==============
========================================================= */
const sceneA = new THREE.Scene();
const cameraA = new THREE.PerspectiveCamera(45, window.innerWidth/window.innerHeight, 0.1, 5000);
const rootA = new THREE.Group();
sceneA.add(rootA);

/* Starfield nền */
const starLayersA = [];
for (let l = 0; l < 3; l++){
  const count = 2000 - l * 500;
  const geo = new THREE.BufferGeometry();
  const pos = new Float32Array(count*3);
  const col = new Float32Array(count*3);
  const tmp = new THREE.Color();
  for (let i = 0; i < count; i++){
    const r = 250 + l * 180;
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);
    pos[i*3]   = r * Math.sin(phi) * Math.cos(theta);
    pos[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
    pos[i*3+2] = r * Math.cos(phi);
    const isBlue = Math.random() < 0.15;
    tmp.setHSL(isBlue ? 0.58 : 0.0, isBlue ? 0.5 : 0.0, 0.85 + Math.random()*0.15);
    col[i*3]=tmp.r; col[i*3+1]=tmp.g; col[i*3+2]=tmp.b;
  }
  geo.setAttribute('position', new THREE.BufferAttribute(pos,3));
  geo.setAttribute('color',    new THREE.BufferAttribute(col,3));
  const mat = new THREE.PointsMaterial({
    size: 1.6 - l*0.35, vertexColors:true, map:starTex,
    transparent:true, opacity:0.7 + l*0.1, depthWrite:false,
    blending:THREE.AdditiveBlending, sizeAttenuation:true
  });
  const stars = new THREE.Points(geo, mat);
  sceneA.add(stars);
  starLayersA.push({ stars, speed: 0.00025 - l*0.00007 });
}

/* Event horizon (nhìn thấy) */
rootA.add(new THREE.Mesh(
  new THREE.SphereGeometry(1.7, 48, 48),
  new THREE.MeshBasicMaterial({ color: 0x000000 })
));

/* ★ Invisible hit sphere — dễ click vào hố đen */
const blackHoleHit = new THREE.Mesh(
  new THREE.SphereGeometry(5.0, 16, 16),
  new THREE.MeshBasicMaterial({ visible: false })
);
rootA.add(blackHoleHit);

/* ★ Pulse ring gợi ý clickable */
const pulseRing = new THREE.Mesh(
  new THREE.RingGeometry(2.6, 3.05, 96),
  new THREE.MeshBasicMaterial({
    color: 0x7dd3fc, transparent: true, opacity: 0.15,
    side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false
  })
);
pulseRing.rotation.x = -Math.PI * 0.5 + 0.72;
rootA.add(pulseRing);

/* Disk */
const diskVert = `
  varying vec2 vUv;
  void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }
`;
const diskFrag = `
  precision highp float;
  uniform float uTime;
  uniform float uIntensity;
  varying vec2 vUv;
  float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p){
    vec2 i = floor(p), f = fract(p);
    f = f*f*(3.0-2.0*f);
    return mix(mix(hash(i), hash(i+vec2(1.0,0.0)), f.x),
               mix(hash(i+vec2(0.0,1.0)), hash(i+vec2(1.0,1.0)), f.x), f.y);
  }
  float fbm(vec2 p){
    float v=0.0, a=0.5;
    for(int i=0;i<5;i++){ v += a*noise(p); p*=2.03; a*=0.5; }
    return v;
  }
  void main(){
    vec2 p = vUv * 2.0 - 1.0;
    float r = length(p);
    float a = atan(p.y, p.x);
    float rings  = 0.5 + 0.5*sin(r*46.0 - uTime*1.1);
    rings *= 0.5 + 0.5*sin(r*95.0 + uTime*0.55);
    rings = pow(rings, 1.5);
    float spiralAngle = a + (1.0-r)*5.5 + uTime*0.35;
    vec2 q = vec2(spiralAngle*1.2, r*8.0);
    float n1 = fbm(q + uTime*0.08);
    float n2 = fbm(q*2.6 - uTime*0.15);
    float n3 = fbm(q*5.5 + uTime*0.22);
    float n = n1*0.5 + n2*0.3 + n3*0.2;
    float innerMask = smoothstep(0.05, 0.15, r);
    float outerMask = 1.0 - smoothstep(0.55, 1.0, r);
    float ringMask = innerMask * outerMask;
    float detail = n*0.5 + rings*0.65;
    float intensity = pow(detail, 1.25)*1.25 + 0.08;
    intensity *= ringMask;
    float coreGlow = pow(1.0 - smoothstep(0.0, 0.20, r), 3.0)*1.05;
    float innerFlare = pow(1.0 - smoothstep(0.0, 0.10, r), 2.0)*0.55;
    float t1 = smoothstep(0.10, 0.42, detail);
    float t2 = smoothstep(0.38, 0.78, detail);
    float t3 = smoothstep(0.68, 1.00, detail);
    vec3 colDeep  = vec3(0.03, 0.10, 0.35);
    vec3 colBlue  = vec3(0.10, 0.42, 0.85);
    vec3 colCyan  = vec3(0.38, 0.80, 1.00);
    vec3 colWhite = vec3(0.90, 0.97, 1.00);
    vec3 color = mix(colDeep, colBlue, t1);
    color = mix(color, colCyan, t2);
    color = mix(color, colWhite, t3);
    float pulse = 0.92 + 0.08*sin(uTime*1.8 + r*7.0);
    color *= intensity * pulse;
    color += vec3(0.75,0.92,1.0)*coreGlow;
    color += vec3(0.9,0.97,1.0)*innerFlare;
    float alpha = ringMask*(0.30 + detail*0.70) + coreGlow*0.40 + innerFlare*0.45;
    alpha *= 1.0 - smoothstep(0.78, 1.0, r);
    alpha = clamp(alpha, 0.0, 1.0);
    gl_FragColor = vec4(color * uIntensity, alpha * uIntensity);
  }
`;
const diskGeo = new THREE.PlaneGeometry(70, 70, 1, 1);
const diskMat = new THREE.ShaderMaterial({
  uniforms: { uTime:{value:0}, uIntensity:{value:0.85} },
  vertexShader: diskVert, fragmentShader: diskFrag,
  transparent:true, depthWrite:false,
  blending: THREE.AdditiveBlending, side: THREE.DoubleSide
});
const disk = new THREE.Mesh(diskGeo, diskMat);
disk.rotation.x = -Math.PI * 0.5 + 0.72;
rootA.add(disk);

const diskMat2 = new THREE.ShaderMaterial({
  uniforms: { uTime:{value:320}, uIntensity:{value:0.35} },
  vertexShader: diskVert, fragmentShader: diskFrag,
  transparent:true, depthWrite:false,
  blending: THREE.AdditiveBlending, side: THREE.DoubleSide
});
const disk2 = new THREE.Mesh(diskGeo, diskMat2);
disk2.rotation.x = -Math.PI * 0.5 + 0.72;
disk2.rotation.z = Math.PI * 0.5;
disk2.scale.setScalar(1.25);
rootA.add(disk2);

/* Core glow */
const outerHalo = new THREE.Sprite(new THREE.SpriteMaterial({
  map: haloGlowTex, transparent:true, blending:THREE.AdditiveBlending,
  depthWrite:false, opacity:0.40, color:0x9ed4ff
}));
outerHalo.scale.set(26, 26, 1);
rootA.add(outerHalo);

const coreGlow = new THREE.Sprite(new THREE.SpriteMaterial({
  map: coreGlowTex, transparent:true, blending:THREE.AdditiveBlending,
  depthWrite:false, opacity:0.75, color:0xffffff
}));
coreGlow.scale.set(11, 11, 1);
rootA.add(coreGlow);

const pinpoint = new THREE.Sprite(new THREE.SpriteMaterial({
  map: coreGlowTex, transparent:true, blending:THREE.AdditiveBlending,
  depthWrite:false, opacity:0.85, color:0xffffff
}));
pinpoint.scale.set(3.6, 3.6, 1);
rootA.add(pinpoint);

/* Jets */
const jetVert = `
  varying vec2 vUv;
  void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }
`;
const jetFrag = `
  precision highp float;
  uniform float uTime;
  varying vec2 vUv;
  float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p){
    vec2 i = floor(p), f = fract(p);
    f = f*f*(3.0-2.0*f);
    return mix(mix(hash(i), hash(i+vec2(1.0,0.0)), f.x),
               mix(hash(i+vec2(0.0,1.0)), hash(i+vec2(1.0,1.0)), f.x), f.y);
  }
  void main(){
    float x = abs(vUv.x - 0.5) * 2.0;
    float y = vUv.y;
    float width = mix(0.95, 0.05, pow(y, 0.55));
    float beam = smoothstep(width, width*0.15, x);
    float streak = noise(vec2(vUv.x*24.0, y*6.0 - uTime*1.4));
    streak = 0.55 + 0.45*streak;
    float streak2 = noise(vec2(vUv.x*58.0 + 13.7, y*18.0 - uTime*3.0));
    streak *= 0.7 + 0.3*streak2;
    float fadeY = pow(1.0 - y, 1.35);
    float flicker = 0.9 + 0.1*sin(uTime*9.0 + y*20.0);
    float intensity = beam * fadeY * flicker * streak * 0.55;
    vec3 colCenter = vec3(0.85, 0.96, 1.00);
    vec3 colEdge = vec3(0.30, 0.70, 1.00);
    vec3 color = mix(colEdge, colCenter, pow(1.0 - x, 2.2));
    float alpha = clamp(pow(intensity, 1.6), 0.0, 0.85);
    gl_FragColor = vec4(color * intensity, alpha);
  }
`;
const jetLength = 95;
const jetWidth = 2.6;
const jetGeo = new THREE.PlaneGeometry(jetWidth, jetLength, 1, 1);
jetGeo.translate(0, jetLength * 0.5, 0);
const jetMatA = new THREE.ShaderMaterial({
  uniforms:{ uTime:{value:0} }, vertexShader: jetVert, fragmentShader: jetFrag,
  transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide
});
const jetMatB = jetMatA.clone();
jetMatB.uniforms = { uTime: { value: 0 } };
const jetGroup = new THREE.Group();
jetGroup.rotation.z = -0.22;
jetGroup.rotation.x = 0.30;
const jetUp = new THREE.Mesh(jetGeo, jetMatA);
const jetDown = new THREE.Mesh(jetGeo, jetMatB);
jetDown.rotation.z = Math.PI;
jetGroup.add(jetUp, jetDown);
rootA.add(jetGroup);

const jetGeoWide = new THREE.PlaneGeometry(jetWidth*1.6, jetLength*0.8, 1, 1);
jetGeoWide.translate(0, jetLength*0.5*0.8, 0);
const jetWideMat = new THREE.ShaderMaterial({
  uniforms:{ uTime:{value:50} }, vertexShader: jetVert, fragmentShader: jetFrag,
  transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide
});
const jetWideUp = new THREE.Mesh(jetGeoWide, jetWideMat);
const jetWideDown = new THREE.Mesh(jetGeoWide, jetWideMat.clone());
jetWideDown.material.uniforms = { uTime: { value: 50 } };
jetWideDown.rotation.z = Math.PI;
jetGroup.add(jetWideUp, jetWideDown);

/* Orbiting dust */
const particleCount = 1600;
const pGeo = new THREE.BufferGeometry();
const pPos = new Float32Array(particleCount*3);
const pCol = new Float32Array(particleCount*3);
const pData = [];
const tmpCol = new THREE.Color();
for (let i = 0; i < particleCount; i++){
  const r = 2.5 + Math.pow(Math.random(), 0.75) * 38;
  const angle = Math.random() * Math.PI * 2;
  const yOff = (Math.random()-0.5) * Math.pow(Math.random(), 2) * 0.6;
  const speed = (0.4 + 0.6*(1-r/42)) * (0.6 + Math.random()*0.5) * 0.5;
  pData.push({ r, angle, speed, yOff });
  const edge = r/40;
  tmpCol.setRGB(0.9, 0.97, 1.0);
  tmpCol.lerp(new THREE.Color(0.35, 0.7, 1.0), edge);
  pCol[i*3]=tmpCol.r; pCol[i*3+1]=tmpCol.g; pCol[i*3+2]=tmpCol.b;
}
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
pGeo.setAttribute('color',    new THREE.BufferAttribute(pCol, 3));
const pMat = new THREE.PointsMaterial({
  size:0.32, vertexColors:true, transparent:true, opacity:0.75,
  depthWrite:false, blending:THREE.AdditiveBlending,
  map:starTex, sizeAttenuation:true
});
const particlesA = new THREE.Points(pGeo, pMat);
rootA.add(particlesA);

/* =========================================================
   CINEMATIC SHOT SYSTEM (quasar)
========================================================= */
const SHOTS = [
  { name:'wide', r:55, phi:0.35, theta:0.4,   look:{x:0,y:0,z:0}, fov:45, dur:9 },
  { name:'disk', r:24, phi:0.60, theta:-0.8,  look:{x:0,y:0,z:0}, fov:42, dur:8 },
  { name:'edge', r:34, phi:0.06, theta:1.9,   look:{x:0,y:0,z:0}, fov:45, dur:8 },
  { name:'jet',  r:42, phi:1.05, theta:0.1,   look:{x:0,y:6,z:0}, fov:40, dur:9 },
  { name:'top',  r:48, phi:1.30, theta:-1.5,  look:{x:0,y:0,z:0}, fov:48, dur:9 },
];

let currentShotIndex = 0;
let tourPlaying = true;
let tourPlayingBeforeWarp = true;
let tourTween = null;
let driftTime = 0;

const camStateA = {
  r: SHOTS[0].r, phi: SHOTS[0].phi, theta: SHOTS[0].theta,
  lookX:0, lookY:0, lookZ:0, fov: SHOTS[0].fov
};

function applyCameraA(){
  const x = camStateA.r * Math.cos(camStateA.phi) * Math.sin(camStateA.theta);
  const y = camStateA.r * Math.sin(camStateA.phi);
  const z = camStateA.r * Math.cos(camStateA.phi) * Math.cos(camStateA.theta);
  const breath = Math.sin(driftTime*0.4) * 0.35;
  const breathY = Math.cos(driftTime*0.31) * 0.25;
  cameraA.position.set(x + breath, y + breathY, z);
  cameraA.lookAt(camStateA.lookX, camStateA.lookY, camStateA.lookZ);
  if (Math.abs(cameraA.fov - camStateA.fov) > 0.01){
    cameraA.fov += (camStateA.fov - cameraA.fov) * 0.08;
    cameraA.updateProjectionMatrix();
  }
}

function shortestTheta(from, to){
  let diff = to - from;
  while (diff >  Math.PI) diff -= Math.PI*2;
  while (diff < -Math.PI) diff += Math.PI*2;
  return from + diff;
}

function goToShot(index, duration = 2.4){
  if (tourTween) tourTween.kill();
  currentShotIndex = index;
  const shot = SHOTS[index];
  document.querySelectorAll('.shot-dot').forEach((d, i) => {
    d.classList.toggle('active', i === index);
  });
  tourTween = gsap.to(camStateA, {
    r: shot.r, phi: shot.phi,
    theta: shortestTheta(camStateA.theta, shot.theta),
    lookX: shot.look.x, lookY: shot.look.y, lookZ: shot.look.z,
    fov: shot.fov,
    duration, ease:'power2.inOut',
    onComplete: () => {
      if (tourPlaying && STATE === 'quasar'){
        setTimeout(() => {
          if (tourPlaying && STATE === 'quasar' && currentShotIndex === index){
            goToShot((index + 1) % SHOTS.length);
          }
        }, shot.dur * 1000);
      }
    }
  });
}

