function startReturn(){
  if (STATE !== 'space') return;
  STATE = 'returning';
  returnStartTime = elapsed;

  document.getElementById('space-ui').classList.remove('visible');
  const q = document.getElementById('quasar-ui');
  q.classList.remove('hidden');
  q.style.opacity = 0;

  const tl = gsap.timeline();

  // 1. Tăng tốc — lao ngược vào lỗ sâu
  const rush = { val: currentSpeed };
  tl.to(rush, {
    val: 6.0,
    duration: 1.5, ease: 'power3.in',
    onUpdate: () => {
      currentSpeed = rush.val;
      targetSpeed = rush.val;
    }
  }, 0);

  // 2. Flash trắng
  tl.to('#flash', { opacity: 1, duration: 0.35, ease: 'power2.in' }, 1.35);

  // 3. Swap scene
  tl.add(() => {
    composer.removePass(renderPass);
    renderPass = new THREE.RenderPass(sceneA, cameraA);
    composer.insertPass(renderPass, 0);

    renderer.toneMappingExposure = 0.85;

    // Reset camera A về shot wide
    camStateA.r = SHOTS[0].r;
    camStateA.phi = SHOTS[0].phi;
    camStateA.theta = SHOTS[0].theta;
    camStateA.lookX = 0; camStateA.lookY = 0; camStateA.lookZ = 0;
    camStateA.fov = SHOTS[0].fov;
    cameraA.fov = SHOTS[0].fov;
    cameraA.updateProjectionMatrix();
    applyCameraA();

    // Reset state space
    speedLevel = 2;
    targetSpeed = SPEED_LEVELS[2];
    currentSpeed = SPEED_LEVELS[2];
    updateSpeedBars();
    autoCruise = true;
    updateCruiseBtn();

    cameraB.position.set(0,0,0);
    camRigB.rotation.set(0,0,0);
    targetYaw = 0; targetPitch = 0;
    currentYaw = 0; currentPitch = 0;

    // Đưa streak về vị trí ban đầu (tránh dính chỗ cũ khi quay lại lần 2)
    const arr = streaksMesh.geometry.attributes.position.array;
    for (let i = 0; i < STREAK_COUNT; i++){
      const s = streaks[i];
      const idx = i * 6;
      arr[idx]   = s.x; arr[idx+1] = s.y; arr[idx+2] = s.z + s.tailLen;
      arr[idx+3] = s.x; arr[idx+4] = s.y; arr[idx+5] = s.z;
    }
    streaksMesh.geometry.attributes.position.needsUpdate = true;

    bloomPass.strength = 0.55;
    bloomPass.radius = 0.45;
    bloomPass.threshold = 0.45;
  }, 1.65);

  // 4. Flash tắt
  tl.to('#flash', { opacity: 0, duration: 1.5, ease: 'power2.out' }, 1.7);

  // 5. Hiện lại quasar UI
  tl.add(() => {
    STATE = 'quasar';
    q.style.opacity = 1;

    // Cập nhật dot về shot 0
    document.querySelectorAll('.shot-dot').forEach((d, i) => {
      d.classList.toggle('active', i === 0);
    });
    currentShotIndex = 0;

    // Khôi phục trạng thái tour
    tourPlaying = tourPlayingBeforeWarp;
    updatePlayIcon();

    // Hint bar hiện lại nhẹ
    hintBar.classList.remove('dim', 'hover');
    hintBar.classList.add('show');
    setTimeout(() => {
      hintBar.classList.remove('show');
      hintBar.classList.add('dim');
    }, 5000);

    // Nếu tour đang bật, resume
    if (tourPlaying){
      setTimeout(() => {
        if (tourPlaying && STATE === 'quasar'){
          goToShot(1, 3.0);
        }
      }, 800);
    }
  }, 3.2);
}

