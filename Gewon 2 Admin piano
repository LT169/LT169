    days.push({ lb:`${d.getDate()}/${d.getMonth()+1}`, v, ts:d.getTime() });
  }
  const mx = Math.max(...days.map(d=>d.v), 1);
  $('#bar-chart').innerHTML = days.map(d => `
    <div class="bar-w"><div class="bar" style="height:${d.v?Math.max(8,(d.v/mx)*100):4}%" data-v="${fmtV(d.v)}"></div><div class="bar-lb">${d.lb}</div></div>
  `).join('');

  // Status rows
  const total = ords||1;
  $('#status-bd').innerHTML = [0,1,2,3].map(i => {
    const cnt = STATE.orders.filter(o => (o.status??2)===i).length;
    const pct = Math.round(cnt/total*100);
    const cl = STATUS_COLORS[i];
