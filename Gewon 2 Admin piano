}

/* ═══ SETTINGS ═══ */
async function saveCloudConfig(){
  const apiKey = $('#cfg-api').value.trim();
  const binId  = $('#cfg-bin').value.trim();
  if(!apiKey || !binId){ toast('⚠️ Nhập đủ','error'); return; }
  toast('⏳ Đang kiểm tra...','info');
  try{
    await Cloud.test(apiKey, binId);
    CLOUD.apiKey = apiKey;
    CLOUD.binId = binId;
    CLOUD.hasCloud = true;
    localStorage.setItem(CFG.LS_API, apiKey);
    localStorage.setItem(CFG.LS_BIN, binId);
    setCloudStatus('online','Realtime ON');
    $('#cfg-status').textContent = '✅ Đã kết nối';
    $('#cfg-key-display').textContent = apiKey.slice(0,16)+'...'+apiKey.slice(-6);
    $('#cfg-bin-display').textContent = binId;
    $('#snippet-panel').style.display = 'block';
    renderSnippet();
    await pullFromCloud(false);
    startAutoSync();
    toast('✅ Kết nối thành công!','success');
  }catch(e){ toast('❌ '+e.message,'error'); }
}
async function autoCreateBin(){
  const apiKey = $('#cfg-api').value.trim();
  if(!apiKey){ toast('⚠️ Nhập API Key trước','error'); return; }
  const btn = $('#btn-auto-bin');
  btn.disabled = true; btn.textContent = '⏳...';
  try{
    const r = await fetch(`${CFG.API_BASE}/b`, {
      method:'POST',
      headers:{ 'Content-Type':'application/json', 'X-Master-Key':apiKey, 'X-Bin-Name':'gewon-'+Date.now(), 'X-Bin-Private':'true' },
      body: JSON.stringify({ orders:[], meta:{}, sessions:{}, events:[], lastUpdate:0, version:3 })
    });
    if(!r.ok) throw new Error('HTTP '+r.status);
    const d = await r.json();
    const id = d.metadata?.id || d.id;
    if(!id) throw new Error('Không nhận được Bin ID');
    $('#cfg-bin').value = id;
    toast('✅ Đã tạo Bin!','success');
  }catch(e){ toast('❌ '+e.message,'error'); }
  finally{ btn.disabled = false; btn.textContent = '⚡ Tạo Bin tự động'; }
}
function disconnectCloud(){
  confirmDlg('Ngắt cloud?', 'Dữ liệu local vẫn giữ.', () => {
    localStorage.removeItem(CFG.LS_API);
    localStorage.removeItem(CFG.LS_BIN);
    CLOUD.hasCloud = false; CLOUD.apiKey = ''; CLOUD.binId = '';
    stopAutoSync();
    setCloudStatus('local','Chỉ lưu máy này');
    $('#cfg-status').textContent = 'Chưa kết nối';
    toast('🔌 Đã ngắt','success');
  });
}
function updateSyncLabel(){
  const el = $('#last-sync');
  if(el) el.textContent = CLOUD.hasCloud ? (CLOUD.lastSync?'Sync '+fmtTime(CLOUD.lastSync):'Chưa sync') : 'Chỉ local';
  const c = $('#cfg-last');
  if(c) c.textContent = CLOUD.lastSync ? fmtD(CLOUD.lastSync) : '—';
  const s = $('#cfg-sessions');
  if(s) s.textContent = getActiveSessions().length;
}
function startAutoSync(){
  if(CLOUD.timer) clearInterval(CLOUD.timer);
  CLOUD.timer = setInterval(() => { if(CLOUD.hasCloud) pullFromCloud(false); }, 3000); // ⚡ 3 giây
}
function stopAutoSync(){ if(CLOUD.timer){ clearInterval(CLOUD.timer); CLOUD.timer = null; } }

function clearEvents(){
  confirmDlg('Xóa toàn bộ sự kiện?', 'Sẽ xóa lịch sử hoạt động. Không ảnh hưởng đơn hàng.', () => {
    STATE.events = [];
    saveLocal(); rerender();
    toast('🗑️ Đã xóa sự kiện','success');
    if(CLOUD.hasCloud) pushToCloud(false);
  });
}

