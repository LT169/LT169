}

/* ═══ CUSTOMERS + ORDERS (giữ nguyên logic cũ) ═══ */
function getCusts(){
  const map = new Map();
  STATE.orders.forEach(o => {
    const k = (o.phone || o.name || 'x').trim().toLowerCase();
    if(!map.has(k)) map.set(k, { key:k, name:o.name||'—', phone:o.phone||'—', address:o.address||'—', orders:[], total:0, firstOrder:o.createdAt, lastOrder:o.createdAt });
    const c = map.get(k);
    c.orders.push(o);
    c.total += parseP(o.product?.price);
    if(o.createdAt>c.lastOrder) c.lastOrder = o.createdAt;
    if(o.createdAt<c.firstOrder) c.firstOrder = o.createdAt;
    if(o.name) c.name = o.name;
    if(o.address) c.address = o.address;
  });
  return [...map.values()].map(c => ({
    ...c, orderCount:c.orders.length,
    tag: STATE.meta[c.key]?.tag || 'none',
    note: STATE.meta[c.key]?.note || ''
  }));
}
const getCustByKey = k => getCusts().find(c => c.key === k);

function renderCust(){
  const s = ($('#cust-search')?.value||'').trim().toLowerCase();
  const tag = $('#cust-tag')?.value||'';
  const sort = $('#cust-sort')?.value||'recent';
  let list = getCusts();
  if(s) list = list.filter(c => c.name.toLowerCase().includes(s) || c.phone.toLowerCase().includes(s) || c.address.toLowerCase().includes(s));
  if(tag) list = list.filter(c => c.tag === tag);
  const sorters = { recent:(a,b)=>b.lastOrder-a.lastOrder, spent:(a,b)=>b.total-a.total, orders:(a,b)=>b.orderCount-a.orderCount, name:(a,b)=>a.name.localeCompare(b.name,'vi') };
  list.sort(sorters[sort]||sorters.recent);
  const tb = $('#cust-tbody'), em = $('#cust-empty');
  if(!list.length){ tb.innerHTML=''; em.classList.remove('hidden'); return; }
  em.classList.add('hidden');
  tb.innerHTML = list.map(c => `
    <tr onclick="openCustDetail('${esc(c.key)}')">
      <td><div class="av-cell"><div class="av ${avC(c.key)}">${inits(c.name)}</div><div><div class="cell-nm">${esc(c.name)}</div><div style="font-size:11.5px;color:var(--muted)">${esc(c.address)}</div></div></div></td>
      <td><span class="cell-mono">${esc(c.phone)}</span></td>
      <td>${c.orderCount} đơn</td>
      <td class="cell-money">${fmtV(c.total)}</td>
      <td>${tagBadge(c.tag)}</td>
      <td style="font-size:12px;color:var(--muted)">${fmtD(c.lastOrder)}</td>
      <td onclick="event.stopPropagation()"><div class="row-act"><button class="ico-btn" onclick="openCustEdit('${esc(c.key)}')">✏️</button><button class="ico-btn dng" onclick="delCust('${esc(c.key)}')">🗑️</button></div></td>
    </tr>
  `).join('');
}
function tagBadge(t){
  return ({ vip:'<span class="tag vip">👑 VIP</span>', new:'<span class="tag new">🆕 Mới</span>', potential:'<span class="tag potential">⭐ Tiềm năng</span>', inactive:'<span class="tag inactive">💤 Không HĐ</span>' })[t] || '<span style="color:var(--muted-2);font-size:12px">—</span>';
}

function renderOrd(){
