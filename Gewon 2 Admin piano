            <div class="info-row"><dt>Trạng thái</dt><dd id="cfg-status">Chưa kết nối</dd></div>
            <div class="info-row"><dt>API Key</dt><dd id="cfg-key-display">—</dd></div>
            <div class="info-row"><dt>Bin ID</dt><dd id="cfg-bin-display">—</dd></div>
            <div class="info-row"><dt>Đồng bộ cuối</dt><dd id="cfg-last">—</dd></div>
