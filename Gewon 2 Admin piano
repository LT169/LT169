  if(!s){ toast('Session đã hết','info'); return; }
  const name = s.name || 'Khách ' + s.id.slice(-4);
  const sessionEvents = (STATE.events || []).filter(e => e.sid === sid).sort((a,b) => a.ts - b.ts);

  openModal(`
