/* ═══ LOCAL ═══ */
function loadLocal(){
  try{
    const o=localStorage.getItem(CFG.LS_ORDERS); if(o) STATE.orders = JSON.parse(o)||[];
    const m=localStorage.getItem(CFG.LS_META); if(m) STATE.meta = JSON.parse(m)||{};
    const s=localStorage.getItem(CFG.LS_SESS); if(s) STATE.sessions = JSON.parse(s)||{};
    const e=localStorage.getItem(CFG.LS_EVENTS); if(e) STATE.events = JSON.parse(e)||[];
  }catch(e){}
}
function saveLocal(){
  try{
    localStorage.setItem(CFG.LS_ORDERS, JSON.stringify(STATE.orders));
    localStorage.setItem(CFG.LS_META, JSON.stringify(STATE.meta));
    localStorage.setItem(CFG.LS_SESS, JSON.stringify(STATE.sessions));
    localStorage.setItem(CFG.LS_EVENTS, JSON.stringify(STATE.events));
    localStorage.setItem(CFG.LS_LAST, String(Date.now()));
  }catch(e){}
}

/* ═══ BOOT ═══ */
async function boot(){
  loadLocal();
  updateSoundBtn();
  updateNotifStatus();
  renderSnippet();
  updateSyncLabel();
  go('live');
  updateBadges();

  const apiKey = localStorage.getItem(CFG.LS_API);
  const binId  = localStorage.getItem(CFG.LS_BIN);
  if(apiKey && binId){
    CLOUD.apiKey = apiKey;
    CLOUD.binId = binId;
    CLOUD.hasCloud = true;
    setCloudStatus('syncing','Đang kết nối...');
    $('#cfg-status').textContent = '✅ Đã kết nối';
    $('#cfg-key-display').textContent = apiKey.slice(0,16)+'...'+apiKey.slice(-6);
    $('#cfg-bin-display').textContent = binId;
    $('#snippet-panel').style.display = 'block';
    $('#cfg-api').value = apiKey;
    $('#cfg-bin').value = binId;
    try{
      await pullFromCloud(false);
      startAutoSync();
      toast('🔴 Realtime đã bật · Pull 3s/lần','success');
    }catch(e){ setCloudStatus('offline','Lỗi kết nối'); }
  } else {
    setCloudStatus('local','Chỉ lưu máy này');
  }
}

document.addEventListener('keydown', e => {
  if(e.key==='Escape' && $('#modal').classList.contains('open')) closeModal();
});
document.addEventListener('DOMContentLoaded', () => {
  boot();
  window.addEventListener('online', () => { toast('🌐 Có mạng','success'); pullFromCloud(false); });
  window.addEventListener('offline', () => toast('📴 Mất mạng','error'));
});
</script>
