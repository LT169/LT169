/* ═══ SNIPPET ═══ */
function renderSnippet(){
  const box = $('#snippet-box');
  if(!box) return;
  box.value = `<!-- GEWON LIVE TRACKER v2 — Dán vào cuối index.html -->
<script>
(function(){
  if(window.__GEWON_LIVE__) return; window.__GEWON_LIVE__ = true;
  const GEWON = { apiKey:'${CLOUD.apiKey||''}', binId:'${CLOUD.binId||''}', api:'https://api.jsonbin.io/v3' };
  if(!GEWON.apiKey || !GEWON.binId) return console.warn('[GewonLive] Chưa cấu hình');
  const H = {'Content-Type':'application/json','X-Master-Key':GEWON.apiKey,'X-Bin-Meta':'false'};
  let SID = localStorage.getItem('gewon_sid') || ('S'+Date.now().toString(36)+Math.random().toString(36).slice(2,8));
  localStorage.setItem('gewon_sid', SID);
  const session = { id:SID, name:null, phone:null, page:location.pathname, product:null, cart:[], started:Date.now(), last_seen:Date.now(), ua:navigator.userAgent.slice(0,120), device:/Mobi|Android/i.test(navigator.userAgent)?'mobile':'desktop' };
  async function rd(){ try{ const r=await fetch(GEWON.api+'/b/'+GEWON.binId+'/latest',{headers:H}); return r.ok?await r.json():null; }catch(e){ return null; } }
  async function wr(d){ try{ const r=await fetch(GEWON.api+'/b/'+GEWON.binId,{method:'PUT',headers:H,body:JSON.stringify(d)}); return r.ok; }catch(e){ return false; } }
  async function sync(m){ const d=await rd()||{orders:[],meta:{},sessions:{},events:[]}; if(!d.sessions)d.sessions={}; if(!Array.isArray(d.events))d.events=[]; if(!Array.isArray(d.orders))d.orders=[]; m(d); d.lastUpdate=Date.now(); d.version=3; d.events=d.events.slice(-300); return await wr(d); }
  async function hb(){ session.last_seen=Date.now(); await sync(d=>{ d.sessions[SID]={...session}; }); }
  async function ev(type,data){ await sync(d=>{ d.events.push({ id:'E'+Date.now().toString(36)+Math.random().toString(36).slice(2,6), type, sid:SID, name:session.name, phone:session.phone, data:data||{}, ts:Date.now() }); d.sessions[SID]={...session}; }); }
  window.GewonLive = {
    viewProduct(p){ session.product=p?.name||p; session.page='product:'+(p?.id||p?.name||''); ev('view_product',{product:p?.name||p,price:p?.price,image:p?.image}); },
    addToCart(p,q){ q=q||1; session.cart.push({name:p?.name,price:p?.price,qty:q}); ev('add_to_cart',{product:p?.name,price:p?.price,qty:q}); },
    identify(n,ph){ if(n)session.name=n; if(ph)session.phone=ph; ev('identify',{name:n,phone:ph}); },
    checkoutStart(){ session.page='checkout'; ev('checkout_start',{}); },
    async orderPlaced(o){ session.name=o?.name||session.name; session.phone=o?.phone||session.phone; session.page='order_complete'; await ev('order_placed',{code:o?.code,product:o?.product?.name,price:o?.product?.price,total:o?.total||o?.product?.price,address:o?.address}); await sync(d=>{ if(o?.code && !d.orders.some(x=>x.code===o.code)) d.orders.unshift(o); d.sessions[SID]={...session}; }); },
    pageChange(p){ session.page=p; hb(); },
    getSessionId(){ return SID; }
  };
  window.addEventListener('load', () => {
    if(typeof openDetail==='function'){ const o=openDetail; openDetail=function(id){ o.call(this,id); try{ const p=(DB&&DB[id])||null; if(p) GewonLive.viewProduct(p); }catch(e){} }; }
    if(typeof orderProduct==='function'){ const o=orderProduct; orderProduct=function(){ o.call(this); GewonLive.checkoutStart(); }; }
    if(typeof confirmShipping==='function'){ const o=confirmShipping; confirmShipping=function(){ const n=document.getElementById('ship-name')?.value?.trim(); const p=document.getElementById('ship-phone')?.value?.trim(); if(n||p)GewonLive.identify(n,p); const a=document.getElementById('ship-address')?.value?.trim(); const r=o.call(this); setTimeout(()=>{ const c=document.getElementById('s-code')?.textContent||''; if(c.startsWith('#GW-')) GewonLive.orderPlaced({code:c,name:n,phone:p,address:a,product:pendingProduct}); },300); return r; }; }
    if(typeof saveOrders==='function'){ const s=saveOrders; saveOrders=function(list){ s.call(this,list); (async()=>{ await sync(d=>{ d.orders=list; d.sessions[SID]={...session}; }); })(); }; }
    hb(); setInterval(hb,10000);
    let lp=location.pathname+location.search; setInterval(()=>{ const c=location.pathname+location.search; if(c!==lp){ lp=c; GewonLive.pageChange(c); } },1000);
    setInterval(async()=>{ const d=await rd(); if(!d||!Array.isArray(d.orders))return; localStorage.setItem('gewon_orders_v1',JSON.stringify(d.orders)); if(typeof renderOrders==='function')renderOrders(); if(typeof updateOrderBadge==='function')updateOrderBadge(); },20000);
    console.log('[GewonLive] ✅ Session:',SID);
  });
})();
<\/script>`;
}
