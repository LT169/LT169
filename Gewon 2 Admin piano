/* ═══ EXPORT / IMPORT / SEED ═══ */
function dl(c,n,m){ const b=new Blob([c],{type:m}); const u=URL.createObjectURL(b); const a=document.createElement('a'); a.href=u; a.download=n; document.body.appendChild(a); a.click(); setTimeout(()=>{ document.body.removeChild(a); URL.revokeObjectURL(u); },100); }
function exportCSV(){ const rows=[['Mã','Tên','SĐT','ĐC','SP','Giá','TT','Ngày']]; STATE.orders.forEach(o=>rows.push([o.code,o.name,o.phone,o.address,o.product?.name||'',o.product?.price||'',STATUS_NAMES[o.status??2],new Date(o.createdAt).toLocaleString('vi-VN')])); dl('\uFEFF'+rows.map(r=>r.map(c=>`"${String(c??'').replace(/"/g,'""')}"`).join(',')).join('\n'),`gewon-orders-${Date.now()}.csv`,'text/csv;charset=utf-8'); toast('📥 Đã xuất','success'); }
function exportCustCSV(){ const rows=[['Tên','SĐT','ĐC','Số đơn','Tổng chi','Loại','Ghi chú']]; getCusts().forEach(c=>rows.push([c.name,c.phone,c.address,c.orderCount,c.total,c.tag,c.note])); dl('\uFEFF'+rows.map(r=>r.map(c=>`"${String(c??'').replace(/"/g,'""')}"`).join(',')).join('\n'),`gewon-cust-${Date.now()}.csv`,'text/csv;charset=utf-8'); toast('📥 Đã xuất','success'); }
function exportJSON(){ dl(JSON.stringify({orders:STATE.orders,meta:STATE.meta,sessions:STATE.sessions,events:STATE.events,exportedAt:Date.now()},null,2),`gewon-backup-${Date.now()}.json`,'application/json'); toast('📥 Đã xuất JSON','success'); }
function importJSON(e){ const f=e.target.files[0]; if(!f)return; const r=new FileReader(); r.onload=ev=>{ try{ const d=JSON.parse(ev.target.result); if(Array.isArray(d.orders))STATE.orders=d.orders; if(d.meta)STATE.meta=d.meta; if(d.sessions)STATE.sessions=d.sessions; if(Array.isArray(d.events))STATE.events=d.events; saveLocal(); rerender(); updateBadges(); toast('✅ Đã nhập','success'); if(CLOUD.hasCloud)pushToCloud(false); }catch(err){ toast('❌ Lỗi','error'); } e.target.value=''; }; r.readAsText(f); }
function wipeAll(){ confirmDlg('Xóa hết?','Toàn bộ đơn, khách, session sẽ bị xóa.',()=>{ STATE.orders=[]; STATE.meta={}; STATE.sessions={}; STATE.events=[]; saveLocal(); rerender(); updateBadges(); toast('🗑️ Đã xóa','success'); if(CLOUD.hasCloud)pushToCloud(false); }); }

