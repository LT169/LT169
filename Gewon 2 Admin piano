        <div><h1>Đơn hàng</h1><p>Bấm dòng để xem chi tiết</p></div>
        <div class="pg-actions"><button class="btn btn-gho btn-sm" onclick="exportCSV()">📥 Xuất CSV</button></div>
      </div>
      <div class="panel">
        <div class="tools">
          <div class="search"><input id="ord-search" placeholder="Tìm mã đơn, tên, SĐT..." oninput="renderOrd()"></div>
          <select class="sel" id="ord-st" onchange="renderOrd()">
            <option value="">Tất cả trạng thái</option>
