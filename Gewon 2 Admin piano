<!-- Toast -->
<div id="toast"></div>

<script>
'use strict';
const $ = (s,r=document)=>r.querySelector(s);
const $$ = (s,r=document)=>[...r.querySelectorAll(s)];

const CFG = {
  LS_API:'gewon_admin_api_key', LS_BIN:'gewon_admin_bin_id',
  LS_LAST:'gewon_admin_last_sync', LS_ORDERS:'gewon_admin_orders',
  LS_META:'gewon_admin_meta', LS_SESS:'gewon_admin_sessions',
  LS_EVENTS:'gewon_admin_events', LS_SOUND:'gewon_admin_sound',
  API_BASE:'https://api.jsonbin.io/v3'
};

let STATE = { orders:[], meta:{}, sessions:{}, events:[], lastUpdate:0 };
let CLOUD = { apiKey:'', binId:'', hasCloud:false, timer:null, lastSync:0 };
let currentPage = 'live';
let SOUND_ON = localStorage.getItem(CFG.LS_SOUND) !== '0';
let LAST_SEEN_EVENT_ID = null;
let LAST_ORDER_CODES = new Set();
let NEW_ORDER_IDS = new Set();
let PUSH_TIMEOUTS = [];

const STATUS_NAMES = ['Đã xác nhận','Chuẩn bị hàng','Đang giao','Đã giao'];
const STATUS_COLORS = ['#3b82f6','#a855f7','#f5a524','#10b981'];
const EVENT_META = {
  order_placed:  { em:'🛒', label:'CHỐT ĐƠN', cls:'order-event', ic:'green' },
  add_to_cart:   { em:'➕', label:'Thêm giỏ', cls:'cart-event', ic:'accent' },
  view_product:  { em:'👁️', label:'Xem sản phẩm', cls:'view-event', ic:'blue' },
  checkout_start:{ em:'💳', label:'Bắt đầu đặt', cls:'checkout-event', ic:'purple' },
  identify:      { em:'👤', label:'Cung cấp tên/SĐT', cls:'', ic:'' }
};

/* ── UTILS ── */
const esc = s => String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const parseP = s => typeof s==='number'?s:(parseInt(String(s??'').replace(/[^\d]/g,''),10)||0);
const fmtV = n => !n?'0đ':Number(n).toLocaleString('vi-VN')+'đ';
const fmtS = n => n>=1e9?(n/1e9).toFixed(1)+' tỷ':n>=1e6?(n/1e6).toFixed(1)+' tr':n>=1e3?(n/1e3).toFixed(0)+'K':String(n);
const fmtD = ts => new Date(ts).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
const fmtTime = ts => new Date(ts).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
const fmtAgo = ts => {
  const s = Math.floor((Date.now()-ts)/1000);
  if(s<5) return 'vừa xong';
  if(s<60) return s+'s trước';
  const m = Math.floor(s/60);
  if(m<60) return m+'p trước';
  const h = Math.floor(m/60);
  if(h<24) return h+'h trước';
  return Math.floor(h/24)+'d trước';
};
const inits = n => !n?'?':n.trim().split(/\s+/).slice(-2).map(w=>w[0]).join('').toUpperCase().slice(0,2);
const avC = seed => { const cs=['','b','g','p','r']; let h=0; for(let i=0;i<String(seed).length;i++) h=(h*31+String(seed).charCodeAt(i))>>>0; return cs[h%cs.length]; };

function toast(msg, type='info'){
  const c = $('#toast'); if(!c) return;
  const el = document.createElement('div');
  el.className = 'toast '+type;
  el.textContent = msg;
  c.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transform='translateX(40px)'; el.style.transition='.3s'; setTimeout(()=>el.remove(),300); }, 3200);
}

/* ── SOUND ── */
let _audioCtx = null;
function getAudio(){
  if(!_audioCtx){
    try{ _audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return null; }
  }
  if(_audioCtx.state==='suspended') _audioCtx.resume();
  return _audioCtx;
}
function playOrderSound(){
  if(!SOUND_ON) return;
  const ctx = getAudio(); if(!ctx) return;
  const now = ctx.currentTime;
  // 3 nốt: C5 - E5 - G5 (kiểu chuông)
  const notes = [523.25, 659.25, 783.99];
  notes.forEach((f,i) => {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = f;
    const t = now + i*0.14;
    gain.gain.setValueAtTime(0.0001, t);
    gain.gain.exponentialRampToValueAtTime(0.35, t+0.02);
    gain.gain.exponentialRampToValueAtTime(0.0001, t+0.35);
    osc.connect(gain).connect(ctx.destination);
    osc.start(t);
    osc.stop(t+0.4);
  });
}
function playCartSound(){
  if(!SOUND_ON) return;
  const ctx = getAudio(); if(!ctx) return;
  const now = ctx.currentTime;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(880, now);
  osc.frequency.setValueAtTime(1174.66, now+0.08);
  gain.gain.setValueAtTime(0.0001, now);
  gain.gain.exponentialRampToValueAtTime(0.25, now+0.01);
  gain.gain.exponentialRampToValueAtTime(0.0001, now+0.18);
  osc.connect(gain).connect(ctx.destination);
  osc.start(now);
  osc.stop(now+0.2);
}
function playVisitSound(){
  if(!SOUND_ON) return;
  const ctx = getAudio(); if(!ctx) return;
  const now = ctx.currentTime;
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'sine';
  osc.frequency.value = 660;
  gain.gain.setValueAtTime(0.0001, now);
  gain.gain.exponentialRampToValueAtTime(0.15, now+0.01);
  gain.gain.exponentialRampToValueAtTime(0.0001, now+0.1);
  osc.connect(gain).connect(ctx.destination);
  osc.start(now);
  osc.stop(now+0.15);
}

