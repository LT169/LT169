      </div>
    </section>

    <!-- ═══════════ DASHBOARD ═══════════ -->
    <section id="pg-dash" class="pg">
      <div class="pg-head">
        <div><h1>Bảng điều khiển</h1><p>Tổng quan · <span id="last-sync">—</span></p></div>
        <div class="pg-actions">
          <button class="btn btn-gho btn-sm" onclick="seedDemo()">🌱 Tạo dữ liệu mẫu</button>
          <button class="btn btn-pri btn-sm" onclick="exportCSV()">📥 Xuất CSV</button>
        </div>
      </div>
      <div class="stats" id="dash-stats"></div>
      <div class="two">
        <div class="panel"><div class="panel-hd"><h3>📈 Doanh thu 7 ngày</h3></div><div class="panel-bd"><div class="bar-chart" id="bar-chart"></div></div></div>
        <div class="panel"><div class="panel-hd"><h3>🎯 Trạng thái đơn</h3></div><div class="panel-bd" id="status-bd"></div></div>
      </div>
      <div class="two">
        <div class="panel"><div class="panel-hd"><h3>👑 Top khách hàng</h3><button class="btn btn-gho btn-sm" onclick="go('cust')">Xem tất cả →</button></div><div class="panel-bd" id="top-cust"></div></div>
        <div class="panel"><div class="panel-hd"><h3>🕐 Đơn gần đây</h3><button class="btn btn-gho btn-sm" onclick="go('ord')">Xem tất cả →</button></div><div class="panel-bd" id="recent-ord"></div></div>
      </div>
    </section>

    <!-- ═══════════ CUSTOMERS ═══════════ -->
    <section id="pg-cust" class="pg hidden">
      <div class="pg-head">
        <div><h1>Khách hàng</h1><p>Bấm dòng để xem chi tiết</p></div>
        <div class="pg-actions"><button class="btn btn-gho btn-sm" onclick="exportCustCSV()">📥 Xuất CSV</button></div>
      </div>
      <div class="panel">
        <div class="tools">
          <div class="search"><input id="cust-search" placeholder="Tìm theo tên, SĐT, địa chỉ..." oninput="renderCust()"></div>
          <select class="sel" id="cust-tag" onchange="renderCust()">
