      <div class="sb-dot" style="background:${cl};box-shadow:0 0 8px ${cl}66"></div>
      <div class="sb-name">${STATUS_NAMES[i]}</div>
      <div class="sb-bar"><div style="width:${pct}%;background:${cl}"></div></div>
      <div class="sb-cnt">${cnt}</div>
    </div>`;
  }).join('');

  // Top custs
  const top = [...custs].sort((a,b)=>b.total-a.total).slice(0,5);
  $('#top-cust').innerHTML = top.length ? top.map((c,i) => `
    <div class="mini-o" onclick="openCustDetail('${esc(c.key)}')">
      <div style="font-family:'Space Grotesk';font-size:20px;font-weight:800;width:26px;text-align:center;color:${i===0?'var(--accent-2)':i===1?'#c0c0c0':i===2?'#cd7f32':'var(--muted-2)'}">${i===0?'🥇':i===1?'🥈':i===2?'🥉':'#'+(i+1)}</div>
      <div class="av ${avC(c.key)}">${inits(c.name)}</div>
      <div><strong>${esc(c.name)}</strong><span>${c.orderCount} đơn · ${esc(c.phone)}</span></div>
      <div class="cell-money">${fmtS(c.total)}</div>
    </div>
  `).join('') : '<p style="color:var(--muted);text-align:center;padding:20px;font-size:13px">Chưa có dữ liệu</p>';

  // Recent
  const recent = [...STATE.orders].sort((a,b)=>b.createdAt-a.createdAt).slice(0,5);
  $('#recent-ord').innerHTML = recent.length ? recent.map(o => {
    const st = o.status??2;
    const isNew = NEW_ORDER_IDS.has(o.code);
    return `<div class="mini-o" onclick="openOrdDetail('${esc(o.code)}')" style="${isNew?'background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.5)':''}">
      <div><strong>${esc(o.code)} · ${esc(o.product?.name||'—')}</strong><span>${esc(o.name)} · ${fmtD(o.createdAt)}</span></div>
      <span class="st st-${st}" style="font-size:11px">${STATUS_NAMES[st]}</span>
