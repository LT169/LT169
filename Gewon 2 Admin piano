  $('#dash-stats').innerHTML = `
    <div class="stat" onclick="go('live')">
      <div class="stat-ic g">🔴</div>
      <div class="stat-lb">Đang online</div>
      <div class="stat-vl">${online}</div>
      <div class="stat-sb">Bấm để xem chi tiết →</div>
