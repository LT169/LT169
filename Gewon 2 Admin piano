/* ═══ ACTIVE SESSIONS ═══ */
function getActiveSessions(){
  const now = Date.now();
  return Object.values(STATE.sessions || {})
    .filter(s => s.last_seen > now - 60000) // online trong 60s
    .sort((a,b) => b.last_seen - a.last_seen);
}

/* ═══ RENDER ═══ */
function rerender(){
  if(currentPage==='dash') renderDash();
  if(currentPage==='cust') renderCust();
  if(currentPage==='ord')  renderOrd();
  if(currentPage==='stats')renderStats();
  if(currentPage==='live') renderLive();
}
function updateBadges(){
  const custs = getCusts();
  const b1 = $('#bd-cust'), b2 = $('#bd-ord'), b3 = $('#bd-live');
  if(b1) b1.textContent = custs.length;
  if(b2) b2.textContent = STATE.orders.length;
  const online = getActiveSessions().length;
  if(b3){
    if(online > 0){ b3.textContent = online; b3.style.display = ''; }
    else b3.style.display = 'none';
  }
}

/* ═══ LIVE RENDER ═══ */
function renderLive(){
  const sessions = getActiveSessions();
  const events = STATE.events || [];
  const now = Date.now();
  const lastHour = events.filter(e => e.ts > now - 3600000);

  // Stats
  const orderEvents = events.filter(e => e.type === 'order_placed');
  const cartEvents = events.filter(e => e.type === 'add_to_cart');
  const ordersToday = orderEvents.filter(e => e.ts > now - 86400000);

  $('#live-stats').innerHTML = `
    <div class="stat" style="cursor:default">
      <div class="stat-ic g">🔴</div>
      <div class="stat-lb">Đang online</div>
      <div class="stat-vl">${sessions.length}</div>
      <div class="stat-sb">Cập nhật realtime · 3s/lần</div>
    </div>
    <div class="stat" style="cursor:default">
      <div class="stat-ic r">🛒</div>
      <div class="stat-lb">Đơn mới hôm nay</div>
      <div class="stat-vl">${ordersToday.length}</div>
      <div class="stat-sb">Tổng: ${orderEvents.length} đơn</div>
    </div>
    <div class="stat" style="cursor:default">
      <div class="stat-ic">➕</div>
      <div class="stat-lb">Thêm giỏ</div>
      <div class="stat-vl">${cartEvents.length}</div>
      <div class="stat-sb">${lastHour.length} sự kiện 1h qua</div>
    </div>
    <div class="stat" style="cursor:default">
      <div class="stat-ic b">📡</div>
      <div class="stat-lb">Tổng sự kiện</div>
      <div class="stat-vl">${events.length}</div>
      <div class="stat-sb">Giới hạn 300 gần nhất</div>
    </div>
  `;

  // Visitors
  const grid = $('#visitor-grid');
  if(sessions.length === 0){
    grid.innerHTML = '<div class="empty" style="grid-column:1/-1;padding:40px"><div class="em" style="font-size:44px">👤</div><h4>Chưa có khách online</h4><p>Khi khách truy cập website, họ sẽ xuất hiện tại đây trong vài giây.</p></div>';
  } else {
    grid.innerHTML = sessions.map(s => {
      const name = s.name || ('Khách ' + s.id.slice(-4));
      const ago = fmtAgo(s.last_seen);
      let actionHtml = '';
      if(s.page === 'checkout'){
        actionHtml = `<div class="visitor-action checkout">💳 Đang điền form đặt hàng</div>`;
      } else if(s.page && s.page.startsWith('order')){
        actionHtml = `<div class="visitor-action ordered">🛒 Đã đặt đơn thành công</div>`;
      } else if(s.product){
        actionHtml = `<div class="visitor-action viewing">👁️ Đang xem: <strong>${esc(s.product)}</strong></div>`;
      } else {
        actionHtml = `<div class="visitor-action">📄 Đang xem: ${esc(s.page || 'trang chủ')}</div>`;
      }

      const meta = [];
      if(s.device === 'mobile') meta.push('📱 Mobile');
      else meta.push('💻 Desktop');
      if(s.phone) meta.push('📞 ' + esc(s.phone));
      meta.push('⏱️ ' + ago);

      return `<div class="visitor-card" onclick="openVisitorDetail('${esc(s.id)}')">
        <div class="visitor-header">
          <div class="visitor-avatar">${inits(name)}</div>
          <div class="visitor-info">
            <strong>${esc(name)}</strong>
            <span>Online ${fmtAgo(s.started).replace(' trước','')}</span>
          </div>
        </div>
        ${actionHtml}
        <div class="visitor-meta">${meta.map(m=>`<span>${m}</span>`).join('')}</div>
      </div>`;
    }).join('');
  }

  // Events feed
  const filterType = $('#event-filter')?.value || '';
  let feedEvents = [...events].sort((a,b) => b.ts - a.ts);
  if(filterType) feedEvents = feedEvents.filter(e => e.type === filterType);
  feedEvents = feedEvents.slice(0, 50);

  const feed = $('#event-feed');
  if(feedEvents.length === 0){
    feed.innerHTML = '<div class="empty" style="padding:40px"><div class="em" style="font-size:44px">📡</div><h4>Chưa có sự kiện</h4><p>Mọi thao tác của khách sẽ hiện tại đây.</p></div>';
  } else {
    feed.innerHTML = feedEvents.map(ev => {
      const meta = EVENT_META[ev.type] || { em:'📌', label:ev.type, cls:'', ic:'' };
      let desc = '';
      if(ev.type === 'order_placed'){
        desc = `<strong>${esc(ev.name || 'Khách ẩn danh')}</strong> vừa chốt đơn <strong>${esc(ev.data?.product||'—')}</strong>`;
        if(ev.data?.code) desc += ` · Mã <span class="cell-mono">${esc(ev.data.code)}</span>`;
      } else if(ev.type === 'add_to_cart'){
        desc = `<strong>${esc(ev.name || 'Khách ẩn danh')}</strong> thêm <strong>${esc(ev.data?.product||'—')}</strong> vào giỏ`;
      } else if(ev.type === 'view_product'){
        desc = `<strong>${esc(ev.name || 'Khách ẩn danh')}</strong> xem <strong>${esc(ev.data?.product||'—')}</strong>`;
      } else if(ev.type === 'checkout_start'){
        desc = `<strong>${esc(ev.name || 'Khách ẩn danh')}</strong> bắt đầu đặt hàng`;
      } else if(ev.type === 'identify'){
        desc = `Khách để lại thông tin: <strong>${esc(ev.name||'?')}</strong> · ${esc(ev.phone||'?')}`;
      } else {
        desc = `<strong>${esc(ev.name||'Khách')}</strong> · ${esc(ev.type)}`;
      }
      const phoneTag = ev.phone ? `<span style="font-size:11px;color:var(--accent-2);margin-left:6px">📞 ${esc(ev.phone)}</span>` : '';
      return `<div class="event-item ${meta.cls}" onclick="${ev.type==='order_placed' && ev.data?.code ? `openOrdDetail('${esc(ev.data.code)}')` : ''}">
        <div class="event-ic ${meta.ic}">${meta.em}</div>
        <div class="event-body">
          <strong>${meta.label}</strong>
          <span>${desc}${phoneTag}</span>
        </div>
        <div class="event-time">${fmtTime(ev.ts)}</div>
      </div>`;
    }).join('');
  }

  $('#live-updated').textContent = CLOUD.lastSync ? 'Cập nhật ' + fmtTime(CLOUD.lastSync) : 'Chưa đồng bộ';
  const oct = $('#online-count-txt');
  if(oct) oct.textContent = sessions.length + ' người';
}

