/* ═══ PUSH NOTIFICATIONS ═══ */
function showPush(opts){
  const area = $('#push-area');
  if(!area) return;
  const el = document.createElement('div');
  el.className = 'push ' + (opts.cls||'');
  el.innerHTML = `
    <div class="push-head">
      <span class="em">${opts.em}</span>
      <strong>${opts.title}</strong>
    </div>
    <div class="push-body">${opts.body}</div>
    ${opts.extra ? `<div style="font-size:12px;color:var(--muted);margin-top:6px">${opts.extra}</div>` : ''}
  `;
  if(opts.onClick){
    el.style.cursor = 'pointer';
    el.onclick = () => { opts.onClick(); el.remove(); };
  }
  area.appendChild(el);
  const t = setTimeout(() => {
    el.style.transition = '.3s';
    el.style.opacity = '0';
    el.style.transform = 'translateX(400px)';
    setTimeout(()=>el.remove(), 300);
  }, 12000);
  PUSH_TIMEOUTS.push(t);
}

