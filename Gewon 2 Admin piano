/* ── BROWSER NOTIFICATION ── */
function requestNotifPermission(){
  if(!('Notification' in window)){ toast('❌ Trình duyệt không hỗ trợ','error'); return; }
  Notification.requestPermission().then(p => {
    updateNotifStatus();
    if(p==='granted') toast('✅ Đã cấp quyền thông báo','success');
    else toast('⚠️ Bạn đã từ chối','info');
  });
}
function updateNotifStatus(){
  const el = $('#cfg-notif-status');
  if(!el) return;
  if(!('Notification' in window)){ el.textContent = 'Không hỗ trợ'; return; }
  const p = Notification.permission;
  el.textContent = p==='granted'?'✅ Đã cấp quyền':p==='denied'?'❌ Bị từ chối':'⏳ Chưa cấp quyền';
}
function sendBrowserNotif(title, body, opts){
  opts = opts || {};
  if(!('Notification' in window)) return;
  if(Notification.permission !== 'granted') return;
  try{
    const n = new Notification(title, { body, icon:'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ctext y=%22.9em%22 font-size=%2290%22%3E🎵%3C/text%3E%3C/svg%3E', tag: opts.tag || 'gewon-'+Date.now(), ...opts });
    setTimeout(()=>n.close(), 8000);
    n.onclick = () => { window.focus(); n.close(); };
  }catch(e){}
}
function testNotif(){
  if(Notification.permission !== 'granted'){ requestNotifPermission(); return; }
  sendBrowserNotif('🎵 Gewon Music', 'Đây là notification test — khi khách đặt đơn bạn sẽ nhận được tin như thế này!', { tag:'test' });
  toast('📬 Đã gửi notification test','success');
}

/* ═══ CLOUD ═══ */
const Cloud = {
  headers(){ return { 'Content-Type':'application/json', 'X-Master-Key':CLOUD.apiKey, 'X-Bin-Meta':'false' }; },
  async read(){
    const r = await fetch(`${CFG.API_BASE}/b/${CLOUD.binId}/latest`, { headers:this.headers() });
    if(!r.ok) throw new Error('read HTTP '+r.status);
    const d = await r.json();
    return d || { orders:[], meta:{}, sessions:{}, events:[], lastUpdate:0 };
  },
  async write(data){
    const r = await fetch(`${CFG.API_BASE}/b/${CLOUD.binId}`, {
      method:'PUT', headers:this.headers(), body: JSON.stringify(data)
    });
    if(!r.ok) throw new Error('write HTTP '+r.status);
    return r.json();
  },
  async test(apiKey, binId){
    const r = await fetch(`${CFG.API_BASE}/b/${binId}/latest`, {
      headers: { 'X-Master-Key':apiKey, 'X-Bin-Meta':'false' }
    });
    if(!r.ok) throw new Error('HTTP '+r.status);
    return r.json();
  }
};

function setCloudStatus(state, label){
  const el = $('#cloud-stat'); if(!el) return;
  el.className = 'cloud-status '+state;
  el.querySelector('.lbl').textContent = label;
}

async function pullFromCloud(showToast){
  if(!CLOUD.hasCloud){ if(showToast) toast('Chưa kết nối cloud','info'); return; }
  try{
    setCloudStatus('syncing','Đang tải...');
    const data = await Cloud.read();
    if(Array.isArray(data.orders)) STATE.orders = data.orders;
    if(data.meta && typeof data.meta==='object') STATE.meta = { ...STATE.meta, ...data.meta };
    if(data.sessions && typeof data.sessions==='object') STATE.sessions = data.sessions;
    if(Array.isArray(data.events)) STATE.events = data.events;
    STATE.lastUpdate = data.lastUpdate || Date.now();
    saveLocal();

    // Detect new events
    detectNewEvents();

    CLOUD.lastSync = Date.now();
    setCloudStatus('online','Realtime ON');
    updateSyncLabel();
    rerender();
    updateBadges();
    if(showToast) toast('✅ Đã tải từ cloud','success');
  }catch(e){
    console.warn('[pull]', e);
    setCloudStatus('offline','Lỗi đồng bộ');
    if(showToast) toast('❌ Lỗi kết nối','error');
  }
}

async function pushToCloud(showToast){
  if(!CLOUD.hasCloud){ if(showToast) toast('Chưa kết nối cloud','info'); return; }
  try{
    setCloudStatus('syncing','Đang gửi...');
    STATE.lastUpdate = Date.now();
    await Cloud.write({
      orders:STATE.orders, meta:STATE.meta,
      sessions:STATE.sessions, events:STATE.events,
      lastUpdate:STATE.lastUpdate, version:3
    });
    CLOUD.lastSync = Date.now();
    setCloudStatus('online','Realtime ON');
    updateSyncLabel();
    if(showToast) toast('☁️ Đã gửi lên cloud','success');
  }catch(e){
    console.warn('[push]', e);
    setCloudStatus('offline','Lỗi gửi');
    if(showToast) toast('❌ Không gửi được','error');
  }
}

/* ═══ NEW EVENT DETECTION ═══ */
function detectNewEvents(){
  // 1. Detect new orders
  const curCodes = new Set(STATE.orders.map(o => o.code));
  const trulyNew = STATE.orders.filter(o => !LAST_ORDER_CODES.has(o.code) && LAST_ORDER_CODES.size > 0);

  // 2. Detect new events (order_placed events)
  const orderEvents = STATE.events.filter(e => e.type === 'order_placed');
  if(orderEvents.length > 0){
    const latestEvent = orderEvents[orderEvents.length - 1];
    if(LAST_SEEN_EVENT_ID && latestEvent.id !== LAST_SEEN_EVENT_ID){
      // Check if this event is not yet shown
      const newer = STATE.events.filter(e =>
        e.id !== LAST_SEEN_EVENT_ID &&
        STATE.events.indexOf(e) > STATE.events.findIndex(x => x.id === LAST_SEEN_EVENT_ID)
      );
      newer.forEach(e => {
        if(e.type === 'order_placed') handleNewOrder(e);
        else if(e.type === 'add_to_cart') handleNewCart(e);
        else if(e.type === 'view_product' && Math.random()<0.3) handleNewView(e);
      });
    }
    LAST_SEEN_EVENT_ID = latestEvent.id;
  }

  // 3. Detect new visitors (sessions < 15s ago, not seen before)
  const now = Date.now();
  const activeSessions = getActiveSessions();
  activeSessions.forEach(s => {
    if(!LAST_ORDER_CODES.has('sess-'+s.id) && now - s.started < 20000 && s.last_seen > now - 15000){
      // Skip — first load, don't alert
    }
  });

  // Update set
  LAST_ORDER_CODES = curCodes;
}

function handleNewOrder(ev){
  const code = ev.data?.code || '(không rõ mã)';
  const name = ev.name || 'Khách ẩn danh';
  const phone = ev.phone || '—';
  const product = ev.data?.product || 'Sản phẩm';
  const price = ev.data?.price || ev.data?.total || '';

  // Sound
  playOrderSound();

  // Push notification on screen
  showPush({
    cls: '',
    em: '🛒',
    title: '🎉 KHÁCH VỪA CHỐT ĐƠN!',
    body: `${name} (${phone}) vừa đặt <strong>${esc(product)}</strong> ${price ? '· '+esc(price) : ''}`,
    extra: `Mã đơn: ${esc(code)}`,
    onClick: () => openOrdDetail(code)
  });

  // Browser notification
  sendBrowserNotif('🎉 Đơn hàng mới!',
    `${name} · ${product} · ${price}`,
    { tag: 'order-'+code }
  );

  // Bell count
  addBellCount();

  // Flash the row
  if(code) NEW_ORDER_IDS.add(code);
  setTimeout(() => {
    NEW_ORDER_IDS.delete(code);
    rerender();
  }, 5000);

  // Toast
  toast(`🎉 Đơn mới: ${code} — ${name}`, 'success');
}

