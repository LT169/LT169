}
function confirmDlg(title, body, onYes){
  openModal(`
    <div class="m-hd"><h3>⚠️ Xác nhận</h3><div class="m-cl" onclick="closeModal()">✕</div></div>
    <div class="m-bd" style="text-align:center;padding:32px 26px">
