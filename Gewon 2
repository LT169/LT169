<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gewon Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  :root{
    --bg:#0b0d12;--surface:#161a22;--surface-2:#1e232d;--surface-3:#272d3a;
    --border:rgba(255,255,255,.09);--border-strong:rgba(255,255,255,.16);
    --text:#fff;--text-2:#d1d7e0;--muted:#9aa4b2;--muted-2:#6b7688;
    --accent:#f5a524;--accent-2:#ffb84d;--accent-glow:rgba(245,165,36,.35);
    --blue:#3b82f6;--blue-2:#60a5fa;--green:#10b981;--green-2:#34d399;
    --red:#ef4444;--red-2:#f87171;--purple:#a855f7;--purple-2:#c084fc;
  }
  body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh;
    background:radial-gradient(ellipse 90% 60% at 50% -10%,rgba(245,165,36,.10),transparent 60%),
      radial-gradient(ellipse 70% 50% at 100% 30%,rgba(59,130,246,.06),transparent 55%),
      linear-gradient(180deg,#0b0d12,#0e1118);background-attachment:fixed}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  input,select,textarea{font-family:inherit;outline:none}
  code{background:var(--surface-2);padding:2px 7px;border-radius:6px;font-size:12.5px;color:var(--accent-2);font-family:'Space Grotesk',monospace}
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:var(--surface-3);border-radius:6px}

  #app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
  aside{background:rgba(11,13,18,.92);border-right:1px solid var(--border);padding:22px 14px;position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
  .side-brand{display:flex;align-items:center;gap:10px;padding:6px 10px 20px;font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;border-bottom:1px solid var(--border);margin-bottom:16px}
  .side-brand::before{content:'';width:10px;height:10px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 0 12px var(--accent-glow)}
  .side-brand small{display:block;font-size:10px;font-weight:600;color:var(--muted);letter-spacing:2px;text-transform:uppercase;margin-top:2px;font-family:Inter,sans-serif}
  .nav-group-label{font-size:10.5px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted-2);padding:10px 12px 6px}
  .nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:11px;font-size:13.5px;font-weight:500;color:var(--text-2);transition:.22s;cursor:pointer;margin-bottom:2px}
  .nav-item .ic{font-size:16px;width:20px;text-align:center}
  .nav-item:hover{background:rgba(255,255,255,.05);color:#fff}
  .nav-item.active{background:linear-gradient(135deg,rgba(245,165,36,.16),rgba(245,165,36,.06));color:#fff;box-shadow:inset 0 0 0 1px rgba(245,165,36,.3)}
  .nav-item .badge{margin-left:auto;background:var(--accent);color:#1a1200;font-size:10.5px;font-weight:800;padding:2px 7px;border-radius:100px;min-width:20px;text-align:center}
  .side-foot{margin-top:auto;padding-top:16px;border-top:1px solid var(--border)}
  .cloud-status{padding:11px 14px;border-radius:11px;background:var(--surface-2);margin-bottom:10px;font-size:12px;display:flex;align-items:center;gap:9px;border:1px solid var(--border);cursor:pointer;transition:.22s}
  .cloud-status:hover{background:var(--surface-3)}
  .cloud-status .dot{width:8px;height:8px;border-radius:50%;background:var(--muted);flex-shrink:0;transition:.3s}
  .cloud-status.online .dot{background:var(--green);box-shadow:0 0 10px var(--green)}
  .cloud-status.syncing .dot{background:var(--accent);box-shadow:0 0 10px var(--accent);animation:pulse 1s infinite}
  .cloud-status.offline .dot{background:var(--red);box-shadow:0 0 10px var(--red)}
  .cloud-status.local .dot{background:var(--blue);box-shadow:0 0 10px var(--blue)}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
  .cloud-status .lbl{color:var(--muted);font-weight:600;flex:1}
  .cloud-status.online .lbl{color:var(--green-2)}
  .cloud-status.syncing .lbl{color:var(--accent-2)}
  .cloud-status.offline .lbl{color:var(--red-2)}
  .cloud-status.local .lbl{color:var(--blue-2)}
  .user-chip{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:11px;background:var(--surface-2);margin-bottom:8px}
  .user-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#1a1200;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px}
  .user-chip div{flex:1;min-width:0}
  .user-chip strong{display:block;font-size:12.5px;color:#fff}
  .user-chip span{display:block;font-size:11px;color:var(--muted)}

  main{padding:28px 36px 60px;overflow-x:hidden;min-width:0}
  .pg-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:26px}
  .pg-head h1{font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;letter-spacing:-.5px;line-height:1.15}
  .pg-head p{font-size:13.5px;color:var(--muted);margin-top:5px}
  .pg-actions{display:flex;gap:8px;flex-wrap:wrap}

  .btn{display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:600;transition:.22s;cursor:pointer;white-space:nowrap}
  .btn-pri{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#1a1200;box-shadow:0 6px 18px rgba(245,165,36,.3)}
  .btn-pri:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(245,165,36,.45)}
  .btn-gho{background:var(--surface-2);color:var(--text-2);border:1px solid var(--border)}
  .btn-gho:hover{background:var(--surface-3);color:#fff}
  .btn-dgr{background:rgba(239,68,68,.12);color:var(--red-2);border:1px solid rgba(239,68,68,.28)}
  .btn-dgr:hover{background:var(--red);color:#fff}
  .btn-sm{padding:7px 13px;font-size:12.5px}

  /* ═══ STAT CARDS — CLICKABLE ═══ */
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:22px}
  .stat{background:linear-gradient(160deg,rgba(22,26,34,.9),rgba(22,26,34,.55));border:1px solid var(--border);border-radius:16px;padding:20px 22px;position:relative;overflow:hidden;cursor:pointer;transition:.25s}
  .stat:hover{transform:translateY(-3px);border-color:rgba(245,165,36,.35);box-shadow:0 12px 32px rgba(0,0,0,.4)}
  .stat:active{transform:translateY(-1px)}
  .stat::after{content:'→';position:absolute;top:16px;right:18px;font-size:16px;color:var(--muted-2);opacity:0;transition:.25s;transform:translateX(-6px)}
  .stat:hover::after{opacity:1;transform:translateX(0);color:var(--accent-2)}
  .stat::before{content:'';position:absolute;top:0;right:0;width:120px;height:120px;border-radius:50%;background:radial-gradient(circle,rgba(245,165,36,.12),transparent 70%);transform:translate(30%,-30%);pointer-events:none}
  .stat-ic{width:40px;height:40px;border-radius:11px;background:rgba(245,165,36,.14);border:1px solid rgba(245,165,36,.25);display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:14px}
  .stat-ic.b{background:rgba(59,130,246,.14);border-color:rgba(59,130,246,.25)}
  .stat-ic.g{background:rgba(16,185,129,.14);border-color:rgba(16,185,129,.25)}
  .stat-ic.p{background:rgba(168,85,247,.14);border-color:rgba(168,85,247,.25)}
  .stat-lb{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
  .stat-vl{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;letter-spacing:-.4px;line-height:1.15;margin-bottom:5px}
  .stat-sb{font-size:12px;color:var(--muted-2)}

  .panel{background:rgba(22,26,34,.75);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:20px}
  .panel-hd{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 22px;border-bottom:1px solid var(--border);flex-wrap:wrap}
  .panel-hd h3{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700}
  .panel-bd{padding:22px}
  .two{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin-bottom:20px}
  @media(max-width:1100px){.two{grid-template-columns:1fr}}

  /* ═══ BAR CHART — CLICKABLE ═══ */
  .bar-chart{display:flex;align-items:flex-end;gap:10px;height:180px;padding:10px 0}
  .bar-w{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer}
  .bar{width:100%;border-radius:7px 7px 0 0;background:linear-gradient(180deg,var(--accent-2),var(--accent));min-height:5px;transition:.3s;box-shadow:0 0 12px rgba(245,165,36,.25);position:relative}
  .bar-w:hover .bar{background:linear-gradient(180deg,#fff,var(--accent-2));box-shadow:0 0 20px rgba(245,165,36,.6);transform:scaleX(1.08)}
  .bar:hover::after{content:attr(data-v);position:absolute;top:-28px;left:50%;transform:translateX(-50%);background:var(--surface-3);padding:4px 9px;border-radius:7px;font-size:11px;font-weight:700;white-space:nowrap;z-index:2}
  .bar-lb{font-size:11px;color:var(--muted);font-weight:600;transition:.2s}
  .bar-w:hover .bar-lb{color:var(--accent-2)}

  /* ═══ STATUS ROWS — CLICKABLE ═══ */
  .sb-row{display:flex;align-items:center;gap:12px;padding:12px 12px 12px 4px;border-radius:10px;border-bottom:1px solid var(--border);cursor:pointer;transition:.2s;margin:0 -8px}
  .sb-row:hover{background:rgba(255,255,255,.04);padding-left:10px}
  .sb-row:last-child{border-bottom:none}
  .sb-row::after{content:'→';color:var(--muted-2);font-size:14px;opacity:0;transition:.22s;margin-left:6px}
  .sb-row:hover::after{opacity:1;color:var(--accent-2)}
  .sb-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
  .sb-name{flex:1;font-size:13.5px;color:var(--text-2)}
  .sb-cnt{font-family:'Space Grotesk';font-weight:700;font-size:15px;color:#fff}
  .sb-bar{width:90px;height:5px;background:var(--surface-3);border-radius:100px;overflow:hidden}
  .sb-bar > div{height:100%;border-radius:100px;transition:.8s}

  .tools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:14px 22px;border-bottom:1px solid var(--border)}
  .search{position:relative;flex:1;min-width:200px;max-width:360px}
  .search input{width:100%;padding:10px 14px 10px 38px;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;color:#fff;font-size:13px}
  .search input:focus{border-color:var(--accent)}
  .search::before{content:'🔍';position:absolute;left:13px;top:50%;transform:translateY(-50%);font-size:13px;opacity:.6}
  .sel{padding:10px 13px;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;color:#fff;font-size:13px;cursor:pointer}
  .sel:focus{border-color:var(--accent)}

  /* ═══ TABLE ROWS — CLICKABLE ═══ */
  .tbl-wrap{overflow-x:auto}
  table{width:100%;border-collapse:collapse}
  thead th{text-align:left;padding:12px 18px;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted);background:rgba(11,13,18,.4);border-bottom:1px solid var(--border);white-space:nowrap}
  tbody td{padding:14px 18px;border-bottom:1px solid var(--border);font-size:13.5px;color:var(--text-2);vertical-align:middle;transition:.2s}
  tbody tr{cursor:pointer;transition:.2s}
  tbody tr:hover{background:rgba(245,165,36,.05)}
  tbody tr:hover td{border-bottom-color:rgba(245,165,36,.25)}
  tbody tr:last-child td{border-bottom:none}
  .cell-nm{color:#fff;font-weight:600;font-size:13.5px}
  .cell-mono{font-family:'Space Grotesk',monospace;font-size:12px;color:var(--accent-2);font-weight:600}
  .cell-money{font-family:'Space Grotesk',sans-serif;font-weight:700;color:var(--green-2);white-space:nowrap}
  .av-cell{display:flex;align-items:center;gap:11px;min-width:190px}
  .av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#1a1200;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0}
  .av.b{background:linear-gradient(135deg,var(--blue),var(--blue-2));color:#fff}
  .av.g{background:linear-gradient(135deg,var(--green),var(--green-2));color:#fff}
  .av.p{background:linear-gradient(135deg,var(--purple),var(--purple-2));color:#fff}
  .av.r{background:linear-gradient(135deg,var(--red),var(--red-2));color:#fff}
  .tag{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:600;white-space:nowrap}
  .tag.vip{background:rgba(245,165,36,.16);color:var(--accent-2);border:1px solid rgba(245,165,36,.3)}
  .tag.new{background:rgba(59,130,246,.16);color:var(--blue-2);border:1px solid rgba(59,130,246,.3)}
  .tag.potential{background:rgba(168,85,247,.16);color:var(--purple-2);border:1px solid rgba(168,85,247,.3)}
  .tag.inactive{background:rgba(107,118,136,.16);color:var(--muted);border:1px solid rgba(107,118,136,.3)}
  .st{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:100px;font-size:12px;font-weight:600;white-space:nowrap}
  .st::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
  .st-0{background:rgba(59,130,246,.14);color:var(--blue-2);border:1px solid rgba(59,130,246,.28)}
  .st-1{background:rgba(168,85,247,.14);color:var(--purple-2);border:1px solid rgba(168,85,247,.28)}
  .st-2{background:rgba(245,165,36,.14);color:var(--accent-2);border:1px solid rgba(245,165,36,.28)}
  .st-3{background:rgba(16,185,129,.14);color:var(--green-2);border:1px solid rgba(16,185,129,.28)}
  .row-act{display:flex;gap:5px;flex-wrap:wrap}
  .ico-btn{width:32px;height:32px;border-radius:9px;background:var(--surface-2);border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;font-size:13px;transition:.2s;cursor:pointer}
  .ico-btn:hover{background:var(--surface-3);transform:translateY(-1px)}
  .ico-btn.dng:hover{background:var(--red);color:#fff;border-color:var(--red)}

  .empty{text-align:center;padding:60px 24px}
  .empty .em{font-size:56px;margin-bottom:14px;opacity:.7}
  .empty h4{font-family:'Space Grotesk';font-size:19px;font-weight:700;margin-bottom:8px}
  .empty p{font-size:13.5px;color:var(--muted);max-width:400px;margin:0 auto 18px;line-height:1.7}

  .modal{position:fixed;inset:0;background:rgba(0,0,0,.82);backdrop-filter:blur(6px);z-index:5000;display:none;align-items:center;justify-content:center;padding:24px}
  .modal.open{display:flex;animation:fade .3s ease}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .modal-box{background:var(--surface);border:1px solid var(--border-strong);border-radius:20px;width:100%;max-width:760px;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 40px 100px rgba(0,0,0,.9);animation:pop .35s cubic-bezier(.2,.9,.3,1)}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
  .m-hd{padding:20px 26px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:14px}
  .m-hd h3{font-family:'Space Grotesk';font-size:18px;font-weight:700}
  .m-hd .m-sub{font-size:12.5px;color:var(--muted);margin-top:3px}
  .m-cl{width:34px;height:34px;border-radius:50%;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--muted);cursor:pointer;transition:.2s;flex-shrink:0}
  .m-cl:hover{background:var(--surface-3);color:#fff}
  .m-bd{padding:26px;overflow-y:auto;flex:1}
  .m-ft{padding:16px 26px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
  .info-row{display:grid;grid-template-columns:130px 1fr;gap:14px;padding:12px 0;border-bottom:1px solid var(--border);font-size:13.5px}
  .info-row:last-child{border-bottom:none}
  .info-row dt{color:var(--muted);font-weight:500}
  .info-row dd{color:#fff;font-weight:500;word-break:break-word}
  .m-sec{font-family:'Space Grotesk';font-size:11.5px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--accent-2);margin:22px 0 12px;padding-bottom:8px;border-bottom:1px solid var(--border)}
  .m-sec:first-child{margin-top:0}

  /* ═══ MINI CARDS — CLICKABLE ═══ */
  .mini-o{display:flex;align-items:center;gap:12px;padding:13px;background:var(--surface-2);border-radius:11px;margin-bottom:9px;border:1px solid var(--border);cursor:pointer;transition:.22s}
  .mini-o:hover{background:var(--surface-3);border-color:rgba(245,165,36,.35);transform:translateX(4px)}
  .mini-o img{width:46px;height:46px;border-radius:9px;object-fit:cover;flex-shrink:0}
  .mini-o > div{flex:1;min-width:0}
  .mini-o strong{display:block;font-size:13px;color:#fff;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .mini-o span{display:block;font-size:11.5px;color:var(--muted);margin-top:2px}
  .mini-o .arrow{color:var(--muted-2);font-size:14px;transition:.22s}
  .mini-o:hover .arrow{color:var(--accent-2);transform:translateX(3px)}

  .tag-sel{display:flex;gap:7px;flex-wrap:wrap;margin-top:6px}
  .tg-btn{padding:7px 13px;border-radius:100px;font-size:11.5px;font-weight:600;border:1px solid var(--border);background:var(--surface-2);color:var(--text-2);cursor:pointer;transition:.2s}
  .tg-btn:hover{color:#fff;background:var(--surface-3)}
  .tg-btn.active.vip{background:rgba(245,165,36,.2);color:var(--accent-2);border-color:rgba(245,165,36,.4)}
  .tg-btn.active.new{background:rgba(59,130,246,.2);color:var(--blue-2);border-color:rgba(59,130,246,.4)}
  .tg-btn.active.potential{background:rgba(168,85,247,.2);color:var(--purple-2);border-color:rgba(168,85,247,.4)}
  .tg-btn.active.inactive{background:rgba(107,118,136,.2);color:var(--muted);border-color:rgba(107,118,136,.4)}
  .tg-btn.active.none{background:var(--surface-3);color:#fff;border-color:var(--border-strong)}
  .frow{margin-bottom:14px}
  .frow label{display:block;font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
  .frow input,.frow textarea,.frow select{width:100%;padding:11px 14px;background:var(--surface-2);border:1px solid var(--border);border-radius:10px;color:#fff;font-size:13.5px}
  .frow input:focus,.frow textarea:focus{border-color:var(--accent)}
  .frow textarea{resize:vertical;min-height:80px}

  /* ═══ STAT DETAIL MODAL ═══ */
  .stat-big{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:20px}
  .stat-big-cell{background:var(--surface-2);padding:16px;border-radius:12px;border:1px solid var(--border)}
  .stat-big-cell .lbl{font-size:10.5px;color:var(--muted);font-weight:700;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:6px}
  .stat-big-cell .vl{font-family:'Space Grotesk';font-size:22px;font-weight:700;color:#fff}
  .stat-big-cell .vl.accent{color:var(--accent-2)}
  .stat-big-cell .vl.green{color:var(--green-2)}
  .stat-big-cell .vl.blue{color:var(--blue-2)}
  .stat-big-cell .vl.purple{color:var(--purple-2)}

  #toast{position:fixed;top:20px;right:20px;z-index:9000;display:flex;flex-direction:column;gap:9px;pointer-events:none}
  .toast{background:var(--surface);border:1px solid var(--border-strong);border-left:3px solid var(--accent);padding:13px 18px;border-radius:11px;font-size:13px;color:#fff;font-weight:500;box-shadow:0 20px 40px rgba(0,0,0,.6);min-width:250px;max-width:360px;animation:slideIn .35s;pointer-events:auto}
  .toast.success{border-left-color:var(--green)}
  .toast.error{border-left-color:var(--red)}
  .toast.info{border-left-color:var(--blue)}
  @keyframes slideIn{from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:translateX(0)}}

