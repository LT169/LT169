        return `<div class="mini-o" onclick="closeModal();setTimeout(()=>openOrdDetail('${esc(o.code)}'),150)">
          <div><strong>${esc(o.code)} · ${esc(o.name)}</strong><span>${fmtD(o.createdAt)} · ${esc(o.phone)}</span></div>
          <span class="st st-${st}" style="font-size:10.5px">${STATUS_NAMES[st]}</span>
