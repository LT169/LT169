<div id="toast"></div>

<script>
'use strict';
/* ══════════════════════════════════════════════════════════════════
   GEWON ADMIN v5.0 — Every click opens detail
   ══════════════════════════════════════════════════════════════════ */
const $  = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => [...r.querySelectorAll(s)];

const CFG = {
  LS_API:   'gewon_admin_api_key',
  LS_BIN:   'gewon_admin_bin_id',
  LS_LAST:  'gewon_admin_last_sync',
  LS_ORDERS:'gewon_admin_orders',
  LS_META:  'gewon_admin_meta',
  API_BASE: 'https://api.jsonbin.io/v3'
};

let STATE = { orders: [], meta: {}, lastUpdate: 0 };
let CLOUD = { apiKey:'', binId:'', hasCloud:false, timer:null, lastSync:0 };
let currentPage = 'dash';

/* ── UTILS ── */
const esc     = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const parseP  = s => typeof s === 'number' ? s : (parseInt(String(s ?? '').replace(/[^\d]/g,''),10) || 0);
const fmtV    = n => !n ? '0đ' : Number(n).toLocaleString('vi-VN')+'đ';
const fmtS    = n => n >= 1e9 ? (n/1e9).toFixed(1)+' tỷ' : n >= 1e6 ? (n/1e6).toFixed(1)+' tr' : n >= 1e3 ? (n/1e3).toFixed(0)+'K' : String(n);
const fmtD    = ts => new Date(ts).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
const fmtDs   = ts => { const d = new Date(ts); return `${d.getDate()}/${d.getMonth()+1}`; };
const fmtDate = ts => { const d = new Date(ts); return `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`; };
const inits   = n => !n ? '?' : n.trim().split(/\s+/).slice(-2).map(w=>w[0]).join('').toUpperCase().slice(0,2);
const avC     = seed => { const cs=['','b','g','p','r']; let h=0; for(let i=0;i<String(seed).length;i++) h=(h*31+String(seed).charCodeAt(i))>>>0; return cs[h%cs.length]; };
const STATUS_NAMES = ['Đã xác nhận','Chuẩn bị hàng','Đang giao','Đã giao'];
const STATUS_COLORS = ['#3b82f6','#a855f7','#f5a524','#10b981'];

function toast(msg, type='info'){
  const c = $('#toast'); if(!c) return;
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  el.textContent = msg;
  c.appendChild(el);
  setTimeout(() => { el.style.opacity='0'; el.style.transform='translateX(40px)'; el.style.transition='.3s'; setTimeout(()=>el.remove(),300); }, 3200);
}

/* ══════════════════════════════════════════════════════════════════
   LOCAL STORAGE
   ══════════════════════════════════════════════════════════════════ */
function loadLocal(){
  try{
    const o = localStorage.getItem(CFG.LS_ORDERS);
    const m = localStorage.getItem(CFG.LS_META);
    if(o) STATE.orders = JSON.parse(o) || [];
    if(m) STATE.meta = JSON.parse(m) || {};
  }catch(e){}
}
function saveLocal(){
  try{
    localStorage.setItem(CFG.LS_ORDERS, JSON.stringify(STATE.orders));
    localStorage.setItem(CFG.LS_META, JSON.stringify(STATE.meta));
    STATE.lastUpdate = Date.now();
    localStorage.setItem(CFG.LS_LAST, String(STATE.lastUpdate));
  }catch(e){}
}

/* ══════════════════════════════════════════════════════════════════
   CLOUD
   ══════════════════════════════════════════════════════════════════ */
const Cloud = {
  headers(){ return { 'Content-Type':'application/json', 'X-Master-Key':CLOUD.apiKey, 'X-Bin-Meta':'false' }; },
  async read(){
    const r = await fetch(`${CFG.API_BASE}/b/${CLOUD.binId}/latest`, { headers: this.headers() });
    if(!r.ok) throw new Error('read HTTP ' + r.status);
    return await r.json();
  },
  async write(data){
    const r = await fetch(`${CFG.API_BASE}/b/${CLOUD.binId}`, {
      method:'PUT', headers:this.headers(), body: JSON.stringify(data)
    });
    if(!r.ok) throw new Error('write HTTP ' + r.status);
    return r.json();
  },
  async test(apiKey, binId){
    const r = await fetch(`${CFG.API_BASE}/b/${binId}/latest`, {
      headers: { 'X-Master-Key': apiKey, 'X-Bin-Meta':'false' }
    });
    if(!r.ok) throw new Error(`HTTP ${r.status}`);
    return r.json();
  }
};

function setCloudStatus(state, label){
  const el = $('#cloud-stat'); if(!el) return;
  el.className = 'cloud-status ' + state;
  el.querySelector('.lbl').textContent = label;
}

async function pullFromCloud(showToast){
  if(!CLOUD.hasCloud){ if(showToast) toast('Chưa kết nối cloud','info'); return; }
  setCloudStatus('syncing','Đang tải...');
  try{
    const data = await Cloud.read();
    if(Array.isArray(data.orders)){
      STATE.orders = data.orders;
      STATE.meta = { ...STATE.meta, ...(data.meta || {}) };
      saveLocal();
    }
    CLOUD.lastSync = Date.now();
    setCloudStatus('online','Đã đồng bộ');
    updateSyncLabel();
    rerender();
    updateBadges();
    if(showToast) toast('✅ Đã tải từ cloud','success');
  }catch(e){
    console.warn('[pull]', e);
    setCloudStatus('offline','Lỗi đồng bộ');
    if(showToast) toast('❌ Không kết nối cloud','error');
  }
}

async function pushToCloud(showToast){
  if(!CLOUD.hasCloud){ if(showToast) toast('Chưa kết nối cloud','info'); return; }
  setCloudStatus('syncing','Đang gửi...');
  try{
    STATE.lastUpdate = Date.now();
    await Cloud.write({ orders:STATE.orders, meta:STATE.meta, lastUpdate:STATE.lastUpdate, version:2 });
    CLOUD.lastSync = Date.now();
    setCloudStatus('online','Đã đồng bộ');
    updateSyncLabel();
    if(showToast) toast('☁️ Đã gửi lên cloud','success');
  }catch(e){
    console.warn('[push]', e);
    setCloudStatus('offline','Lỗi gửi');
    if(showToast) toast('❌ Không gửi được','error');
  }
}

function startAutoSync(){
  if(CLOUD.timer) clearInterval(CLOUD.timer);
  CLOUD.timer = setInterval(() => { if(CLOUD.hasCloud) pullFromCloud(false); }, 15000);
}
function stopAutoSync(){
  if(CLOUD.timer){ clearInterval(CLOUD.timer); CLOUD.timer = null; }
}

/* ══════════════════════════════════════════════════════════════════
   CONFIG CLOUD
   ══════════════════════════════════════════════════════════════════ */
async function saveCloudConfig(){
  const apiKey = $('#cfg-api').value.trim();
  const binId  = $('#cfg-bin').value.trim();
  if(!apiKey || !binId){ toast('⚠️ Nhập đủ API Key và Bin ID','error'); return; }
  toast('⏳ Đang kiểm tra kết nối...','info');
  try{
    await Cloud.test(apiKey, binId);
    CLOUD.apiKey = apiKey;
    CLOUD.binId  = binId;
    CLOUD.hasCloud = true;
    localStorage.setItem(CFG.LS_API, apiKey);
    localStorage.setItem(CFG.LS_BIN, binId);
    setCloudStatus('online','Đã kết nối');
    $('#cfg-status').textContent = '✅ Đã kết nối cloud';
    $('#cfg-key-display').textContent = apiKey.slice(0,16) + '...' + apiKey.slice(-6);
    $('#cfg-bin-display').textContent = binId;
    $('#snippet-panel').style.display = 'block';
    renderSnippet();
    await pushToCloud(false);
    startAutoSync();
    toast('✅ Kết nối cloud thành công!','success');
  }catch(e){
    toast('❌ ' + e.message,'error');
  }
}

async function autoCreateBin(){
  const apiKey = $('#cfg-api').value.trim();
  if(!apiKey){ toast('⚠️ Nhập API Key trước','error'); return; }
  const btn = $('#btn-auto-bin');
  btn.disabled = true;
  btn.textContent = '⏳ Đang tạo...';
  try{
    const r = await fetch(`${CFG.API_BASE}/b`, {
      method:'POST',
      headers: {
        'Content-Type':'application/json',
        'X-Master-Key': apiKey,
        'X-Bin-Name': 'gewon-admin-' + Date.now(),
        'X-Bin-Private': 'true'
      },
      body: JSON.stringify({ orders:[], meta:{}, lastUpdate:0, version:2 })
    });
    if(!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    const id = d.metadata?.id || d.id;
    if(!id) throw new Error('Không nhận được Bin ID');
    $('#cfg-bin').value = id;
    toast('✅ Đã tạo Bin! Bấm "Lưu & kết nối"','success');
  }catch(e){
    toast('❌ ' + e.message,'error');
