  };
  const keys = catMap[catName] || [];
  const orders = STATE.orders.filter(o => {
    const pn = (o.product?.name || '').toLowerCase();
    return keys.some(k => pn.includes(k));
  }).sort((a,b) => b.createdAt - a.createdAt);
  const revenue = orders.reduce((s,o) => s + parseP(o.product?.price), 0);

  openModal(`
    <div class="m-hd">
      <div><h3>📊 Danh mục ${esc(catName)}</h3><div class="m-sub">${orders.length} đơn · ${fmtV(revenue)}</div></div>
      <div class="m-cl" onclick="closeModal()">✕</div>
    </div>
    <div class="m-bd">
      <div class="stat-big">
        <div class="stat-big-cell"><div class="lbl">Số đơn</div><div class="vl">${orders.length}</div></div>
        <div class="stat-big-cell"><div class="lbl">Doanh thu</div><div class="vl green">${fmtS(revenue)}</div></div>
        <div class="stat-big-cell"><div class="lbl">TB/đơn</div><div class="vl accent">${fmtS(orders.length ? Math.round(revenue/orders.length) : 0)}</div></div>
