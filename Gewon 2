function openDayDetail(dayStartTs){
  const dayStart = new Date(dayStartTs); dayStart.setHours(0,0,0,0);
  const dayEnd = new Date(dayStart); dayEnd.setDate(dayEnd.getDate()+1);
  const dayOrders = STATE.orders.filter(o => o.createdAt >= dayStart.getTime() && o.createdAt < dayEnd.getTime())
    .sort((a,b) => b.createdAt - a.createdAt);
  const revenue = dayOrders.reduce((s,o) => s + parseP(o.product?.price), 0);
  const pending = dayOrders.filter(o => (o.status ?? 2) < 3).length;
  const done = dayOrders.filter(o => (o.status ?? 2) === 3).length;

  openModal(`
    <div class="m-hd">
