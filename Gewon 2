   ══════════════════════════════════════════════════════════════════ */
function renderCust(){
  const s = ($('#cust-search')?.value || '').trim().toLowerCase();
  const tag = $('#cust-tag')?.value || '';
  const sort = $('#cust-sort')?.value || 'recent';

  let list = getCusts();
  if(s) list = list.filter(c => c.name.toLowerCase().includes(s) || c.phone.toLowerCase().includes(s) || c.address.toLowerCase().includes(s));
  if(tag) list = list.filter(c => c.tag === tag);

  const sorters = { recent:(a,b)=>b.lastOrder-a.lastOrder, spent:(a,b)=>b.total-a.total, orders:(a,b)=>b.orderCount-a.orderCount, name:(a,b)=>a.name.localeCompare(b.name,'vi') };
  list.sort(sorters[sort] || sorters.recent);

  const tb = $('#cust-tbody'), em = $('#cust-empty');
  if(!list.length){ tb.innerHTML = ''; em.classList.remove('hidden'); return; }
  em.classList.add('hidden');

  tb.innerHTML = list.map(c => `
    <tr onclick="openCustDetail('${esc(c.key)}')">
