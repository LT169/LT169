let EDIT_TAG = null;

function openCustEdit(key){
  const c = getCustByKey(key);
  if(!c) return;
  const tags = [
    {v:'none', l:'— Chưa phân loại'},
    {v:'vip', l:'👑 VIP'},
    {v:'new', l:'🆕 Mới'},
    {v:'potential', l:'⭐ Tiềm năng'},
    {v:'inactive', l:'💤 Không HĐ'}
  ];
  EDIT_TAG = c.tag;

  openModal(`
    <div class="m-hd"><h3>✏️ Chỉnh sửa khách hàng</h3><div class="m-cl" onclick="closeModal()">✕</div></div>
    <div class="m-bd">
      <div class="frow"><label>Họ tên</label><input type="text" value="${esc(c.name)}" readonly style="opacity:.65"></div>
      <div class="frow"><label>Điện thoại</label><input type="text" value="${esc(c.phone)}" readonly style="opacity:.65"></div>
      <div class="frow">
        <label>Phân loại</label>
        <div class="tag-sel" id="tag-sel">
          ${tags.map(t => `<button class="tg-btn ${t.v} ${c.tag === t.v ? 'active' : ''}" data-t="${t.v}" onclick="pickTag('${t.v}')">${t.l}</button>`).join('')}
        </div>
      </div>
      <div class="frow"><label>Ghi chú nội bộ</label><textarea id="edit-note" rows="4" placeholder="VD: Khách quen, sinh nhật 20/5...">${esc(c.note || '')}</textarea></div>
