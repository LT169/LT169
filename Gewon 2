        <div class="stat-big-cell"><div class="lbl">Doanh thu</div><div class="vl green">${fmtS(revenue)}</div></div>
        <div class="stat-big-cell"><div class="lbl">Đã giao</div><div class="vl blue">${done}</div></div>
        <div class="stat-big-cell"><div class="lbl">Đang xử lý</div><div class="vl accent">${pending}</div></div>
      </div>
      <div class="m-sec">Danh sách đơn trong ngày</div>
      ${dayOrders.length ? dayOrders.map(o => {
        const st = o.status ?? 2;
        return `<div class="mini-o" onclick="closeModal();setTimeout(()=>openOrdDetail('${esc(o.code)}'),150)">
          <div><strong>${esc(o.code)} · ${esc(o.product?.name || '—')}</strong><span>${esc(o.name)} · ${new Date(o.createdAt).toLocaleTimeString('vi-VN')} · ${esc(o.product?.price || '—')}</span></div>
