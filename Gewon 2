      <button class="btn btn-gho" onclick="closeModal()">Hủy</button>
      <button class="btn btn-pri" onclick="saveCustEdit('${esc(c.key)}')">💾 Lưu</button>
    </div>
  `);
}

function pickTag(t){
  EDIT_TAG = t;
  $$('#tag-sel .tg-btn').forEach(b => b.classList.toggle('active', b.dataset.t === t));
}

async function saveCustEdit(key){
  const note = $('#edit-note').value.trim();
  STATE.meta[key] = { tag: EDIT_TAG, note };
  saveLocal();
  closeModal();
  rerender();
  toast('✅ Đã lưu khách hàng','success');
  if(CLOUD.hasCloud) pushToCloud(false);
}

function delCust(key){
  const c = getCustByKey(key);
  if(!c) return;
  confirmDlg(
    `Xóa khách <strong>${esc(c.name)}</strong>?`,
    `Sẽ xóa <strong>${c.orderCount} đơn</strong> liên quan. Không thể hoàn tác!`,
    () => {
      STATE.orders = STATE.orders.filter(o => (o.phone || o.name || '').trim().toLowerCase() !== key);
      delete STATE.meta[key];
      saveLocal();
      rerender();
      updateBadges();
      toast('🗑️ Đã xóa khách hàng','success');
      if(CLOUD.hasCloud) pushToCloud(false);
    }
  );
}

/* ══════════════════════════════════════════════════════════════════
   ORDERS
   ══════════════════════════════════════════════════════════════════ */
function renderOrd(){
  const s = ($('#ord-search')?.value || '').trim().toLowerCase();
  const st = $('#ord-st')?.value ?? '';
  const sort = $('#ord-sort')?.value || 'recent';

  let list = [...STATE.orders];
  if(s) list = list.filter(o => (o.code||'').toLowerCase().includes(s) || (o.name||'').toLowerCase().includes(s) || (o.phone||'').toLowerCase().includes(s) || (o.product?.name||'').toLowerCase().includes(s));
  if(st !== '') list = list.filter(o => (o.status ?? 2) === +st);
  const sorters = { recent:(a,b)=>b.createdAt-a.createdAt, oldest:(a,b)=>a.createdAt-b.createdAt, price:(a,b)=>parseP(b.product?.price)-parseP(a.product?.price) };
  list.sort(sorters[sort] || sorters.recent);

  const tb = $('#ord-tbody'), em = $('#ord-empty');
  if(!list.length){ tb.innerHTML = ''; em.classList.remove('hidden'); return; }
  em.classList.add('hidden');

  tb.innerHTML = list.map(o => {
    const s2 = o.status ?? 2;
    return `<tr onclick="openOrdDetail('${esc(o.code)}')">
      <td><div class="cell-mono">${esc(o.code)}</div><div style="font-size:11px;color:var(--muted);margin-top:3px">${esc((o.product?.name||'—').slice(0,24))}</div></td>
      <td><div class="av-cell"><div class="av ${avC(o.phone||o.name)}">${inits(o.name)}</div><div><div class="cell-nm">${esc(o.name||'—')}</div><div style="font-size:11.5px;color:var(--muted)">${esc(o.phone||'—')}</div></div></div></td>
      <td>${o.product?.image ? `<img src="${esc(o.product.image)}" style="width:36px;height:36px;border-radius:8px;object-fit:cover;vertical-align:middle;margin-right:9px" onerror="this.style.display='none'">` : ''}<span style="vertical-align:middle">${esc(o.product?.name || 'Đơn trống')}</span></td>
      <td class="cell-money">${esc(o.product?.price || '—')}</td>
      <td onclick="event.stopPropagation()"><select class="sel" style="padding:6px 10px;font-size:12px" onchange="changeOrdStatus('${esc(o.code)}', this.value)">${[0,1,2,3].map(i => `<option value="${i}" ${i === s2 ? 'selected' : ''}>${STATUS_NAMES[i]}</option>`).join('')}</select></td>
      <td style="font-size:12px;color:var(--muted)">${fmtD(o.createdAt)}</td>
      <td onclick="event.stopPropagation()"><div class="row-act"><button class="ico-btn" onclick="openOrdDetail('${esc(o.code)}')">👁️</button><button class="ico-btn dng" onclick="delOrd('${esc(o.code)}')">🗑️</button></div></td>
    </tr>`;
  }).join('');
}

function changeOrdStatus(code, st){
  const i = STATE.orders.findIndex(o => o.code === code);
  if(i !== -1){
    STATE.orders[i].status = +st;
    saveLocal();
    toast('✅ Đã cập nhật trạng thái','success');
    if(CLOUD.hasCloud) pushToCloud(false);
  }
}

