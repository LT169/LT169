/* ══════════════════════════════════════════════════════════════════
   NAVIGATION
   ══════════════════════════════════════════════════════════════════ */
function go(pg, filterOpts){
  currentPage = pg;
  $$('.pg').forEach(p => p.classList.add('hidden'));
  const t = $('#pg-' + pg);
  if(t) t.classList.remove('hidden');
  $$('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.pg === pg));
  document.querySelector('aside')?.classList.remove('open');

  // Apply filter nếu có
  if(filterOpts){
    if(pg === 'ord' && filterOpts.status !== undefined){
      const sel = $('#ord-st');
      if(sel) sel.value = String(filterOpts.status);
      renderOrd();
    }
    if(pg === 'cust' && filterOpts.tag){
      const sel = $('#cust-tag');
      if(sel) sel.value = filterOpts.tag;
      renderCust();
    }
  } else {
    rerender();
  }
  window.scrollTo({top:0, behavior:'smooth'});
}

function rerender(){
  if(currentPage === 'dash')  renderDash();
  if(currentPage === 'cust')  renderCust();
  if(currentPage === 'ord')   renderOrd();
  if(currentPage === 'stats') renderStats();
}

function updateBadges(){
  const custs = getCusts();
  const b1 = $('#bd-cust'), b2 = $('#bd-ord');
  if(b1) b1.textContent = custs.length;
  if(b2) b2.textContent = STATE.orders.length;
}

/* ══════════════════════════════════════════════════════════════════
   DATA
   ══════════════════════════════════════════════════════════════════ */
function getCusts(){
  const map = new Map();
  STATE.orders.forEach(o => {
    const k = (o.phone || o.name || 'x').trim().toLowerCase();
    if(!map.has(k)){
      map.set(k, { key:k, name:o.name||'—', phone:o.phone||'—', address:o.address||'—', orders:[], total:0, firstOrder:o.createdAt, lastOrder:o.createdAt });
    }
    const c = map.get(k);
    c.orders.push(o);
    c.total += parseP(o.product?.price);
    if(o.createdAt > c.lastOrder) c.lastOrder = o.createdAt;
    if(o.createdAt < c.firstOrder) c.firstOrder = o.createdAt;
    if(o.name) c.name = o.name;
    if(o.address) c.address = o.address;
  });
  return [...map.values()].map(c => ({
    ...c,
    orderCount: c.orders.length,
    tag:  STATE.meta[c.key]?.tag  || 'none',
    note: STATE.meta[c.key]?.note || ''
  }));
}
const getCustByKey = k => getCusts().find(c => c.key === k);

