/* ══════════════════════════════════════════════════════════════════
   SNIPPET
   ══════════════════════════════════════════════════════════════════ */
function renderSnippet(){
  const box = $('#snippet-box');
  if(!box) return;
  const snippet = `<!-- ═══ GEWON CLOUD BRIDGE ═══ -->
<script>
(function(){
  const GEWON = { apiKey:'${CLOUD.apiKey || ''}', binId:'${CLOUD.binId || ''}', api:'https://api.jsonbin.io/v3' };
  if(!GEWON.apiKey || !GEWON.binId) return;
  const H = {'Content-Type':'application/json','X-Master-Key':GEWON.apiKey,'X-Bin-Meta':'false'};
  async function read(){ try{ const r=await fetch(GEWON.api+'/b/'+GEWON.binId+'/latest',{headers:H}); return r.ok?await r.json():null; }catch(e){ return null; } }
  async function write(d){ try{ const r=await fetch(GEWON.api+'/b/'+GEWON.binId,{method:'PUT',headers:H,body:JSON.stringify(d)}); return r.ok; }catch(e){ return false; } }
  async function pull(){ const d=await read(); if(!d||!Array.isArray(d.orders))return; localStorage.setItem('gewon_orders_v1',JSON.stringify(d.orders)); if(typeof renderOrders==='function')renderOrders(); if(typeof updateOrderBadge==='function')updateOrderBadge(); }
  window.addEventListener('load',()=>{
    const orig=window.saveOrders;
    if(typeof orig==='function'){ window.saveOrders=function(list){ orig.call(this,list); (async()=>{ const d=await read()||{orders:[],meta:{}}; d.orders=list; d.meta=d.meta||{}; d.lastUpdate=Date.now(); await write(d); })(); }; }
    pull(); setInterval(pull,20000);
  });
})();
<\/script>`;
  box.value = snippet;
}

function copySnippet(){
  const box = $('#snippet-box');
  box.select();
  navigator.clipboard?.writeText(box.value).then(
    () => toast('📋 Đã copy snippet!','success'),
    () => toast('⚠️ Không copy — chọn tay','error')
  );
}

/* ══════════════════════════════════════════════════════════════════
   EXPORT / IMPORT
   ══════════════════════════════════════════════════════════════════ */
function dl(content, name, mime){
  const b = new Blob([content], { type:mime });
  const u = URL.createObjectURL(b);
  const a = document.createElement('a');
  a.href = u; a.download = name;
  document.body.appendChild(a); a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(u); }, 100);
}

function exportCSV(){
  const rows = [['Mã đơn','Khách hàng','SĐT','Địa chỉ','Sản phẩm','Giá','Trạng thái','Ngày tạo']];
  STATE.orders.forEach(o => rows.push([
    o.code, o.name, o.phone, o.address, o.product?.name || '', o.product?.price || '',
    STATUS_NAMES[o.status ?? 2], new Date(o.createdAt).toLocaleString('vi-VN')
  ]));
  const csv = '\uFEFF' + rows.map(r => r.map(c => `"${String(c ?? '').replace(/"/g,'""')}"`).join(',')).join('\n');
  dl(csv, `gewon-orders-${Date.now()}.csv`, 'text/csv;charset=utf-8');
  toast('📥 Đã xuất CSV','success');
}

function exportCustCSV(){
  const rows = [['Họ tên','SĐT','Địa chỉ','Số đơn','Tổng chi','Phân loại','Ghi chú','Đơn gần nhất']];
  getCusts().forEach(c => rows.push([
    c.name, c.phone, c.address, c.orderCount, c.total,
    c.tag === 'vip' ? 'VIP' : c.tag === 'new' ? 'Mới' : c.tag === 'potential' ? 'Tiềm năng' : c.tag === 'inactive' ? 'Không HĐ' : '',
    c.note, new Date(c.lastOrder).toLocaleString('vi-VN')
  ]));
  const csv = '\uFEFF' + rows.map(r => r.map(c => `"${String(c ?? '').replace(/"/g,'""')}"`).join(',')).join('\n');
  dl(csv, `gewon-customers-${Date.now()}.csv`, 'text/csv;charset=utf-8');
  toast('📥 Đã xuất CSV khách hàng','success');
}

function exportJSON(){
  dl(JSON.stringify({ orders:STATE.orders, meta:STATE.meta, exportedAt:Date.now() }, null, 2),
     `gewon-backup-${Date.now()}.json`, 'application/json');
  toast('📥 Đã xuất JSON','success');
}

function importJSON(e){
  const f = e.target.files[0]; if(!f) return;
  const r = new FileReader();
  r.onload = ev => {
    try{
      const d = JSON.parse(ev.target.result);
      if(!Array.isArray(d.orders)) throw new Error('Không hợp lệ');
      STATE.orders = d.orders;
      if(d.meta && typeof d.meta === 'object') STATE.meta = d.meta;
      saveLocal();
      rerender();
      updateBadges();
      toast('✅ Đã nhập dữ liệu','success');
      if(CLOUD.hasCloud) pushToCloud(false);
    }catch(err){ toast('❌ File không hợp lệ','error'); }
    e.target.value = '';
  };
  r.readAsText(f);
}

function wipeAll(){
  confirmDlg('Xóa toàn bộ dữ liệu?', 'Sẽ xóa tất cả đơn và khách. Không thể hoàn tác!', () => {
    STATE.orders = [];
    STATE.meta = {};
    saveLocal();
    rerender();
    updateBadges();
    toast('🗑️ Đã xóa toàn bộ','success');
    if(CLOUD.hasCloud) pushToCloud(false);
  });
}

