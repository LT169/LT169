/* ══════════════════════════════════════════════════════════════════
   ANALYTICS
   ══════════════════════════════════════════════════════════════════ */
function renderStats(){
  const custs = getCusts();
  const revenue = custs.reduce((s,c) => s + c.total, 0);
  const avgOrd = STATE.orders.length ? Math.round(revenue/STATE.orders.length) : 0;
  const avgCust = custs.length ? Math.round(revenue/custs.length) : 0;
  const repeat = custs.filter(c => c.orderCount > 1).length;
  const repeatPct = custs.length ? Math.round(repeat/custs.length*100) : 0;

  $('#stats-grid').innerHTML = `
    <div class="stat" onclick="openStatDetail('revenue')">
      <div class="stat-ic g">💰</div>
      <div class="stat-lb">Doanh thu</div>
      <div class="stat-vl">${fmtS(revenue)}</div>
      <div class="stat-sb">${STATE.orders.length} đơn · bấm xem chi tiết</div>
    </div>
    <div class="stat" onclick="openStatDetail('orders')">
      <div class="stat-ic b">📈</div>
      <div class="stat-lb">Đơn TB</div>
      <div class="stat-vl">${fmtS(avgOrd)}</div>
      <div class="stat-sb">trung bình / đơn</div>
    </div>
    <div class="stat" onclick="openStatDetail('customers')">
      <div class="stat-ic p">👤</div>
      <div class="stat-lb">Chi / khách</div>
      <div class="stat-vl">${fmtS(avgCust)}</div>
      <div class="stat-sb">trung bình mỗi KH</div>
    </div>
    <div class="stat" onclick="openRepeatCustomers()">
      <div class="stat-ic">🔁</div>
      <div class="stat-lb">Khách quay lại</div>
      <div class="stat-vl">${repeat}</div>
      <div class="stat-sb">${repeatPct}% mua > 1 lần</div>
    </div>
  `;

  // Top products — clickable
  const pm = new Map();
  STATE.orders.forEach(o => {
    if(!o.product?.name) return;
    if(!pm.has(o.product.name)) pm.set(o.product.name, { name:o.product.name, cnt:0, rev:0 });
    const p = pm.get(o.product.name);
    p.cnt++; p.rev += parseP(o.product.price);
  });
  const top = [...pm.values()].sort((a,b) => b.rev - a.rev).slice(0,8);
  const mx = Math.max(...top.map(p => p.rev), 1);
  $('#top-prod').innerHTML = top.length ? top.map(p => `
    <div style="margin-bottom:15px;cursor:pointer;padding:6px 10px;border-radius:8px;transition:.2s" onclick="openProductDetail('${esc(p.name)}')" onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background='transparent'">
      <div style="display:flex;justify-content:space-between;margin-bottom:7px;font-size:13px"><span style="color:#fff;font-weight:600">${esc(p.name)}</span><span style="color:var(--muted)">${p.cnt} đơn · ${fmtS(p.rev)}</span></div>
      <div style="height:5px;background:var(--surface-3);border-radius:100px;overflow:hidden"><div style="width:${Math.round(p.rev/mx*100)}%;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-2));border-radius:100px"></div></div>
    </div>
  `).join('') : '<p style="color:var(--muted);font-size:13px;text-align:center;padding:18px">Chưa có dữ liệu</p>';

  // Categories — clickable
  const cats = [
    { k:'Piano',  color:'#f5a524', keys:['piano','p-45','p-125','cdp','px-s','u1','ap-270','upright','grand','mp-100'] },
    { k:'Guitar', color:'#3b82f6', keys:['f310','c40','d-28','114e','strat','les paul','grx','squier','guitar','acoustic'] },
    { k:'Trống',  color:'#a855f7', keys:['tama','pearl','roland','alesis','drum','trống','rhythm','roadshow','stage','export','td-1k','nitro'] }
  ];
  const cd = cats.map(c => {
    let r = 0, n = 0;
    STATE.orders.forEach(o => {
      const pn = (o.product?.name || '').toLowerCase();
      if(c.keys.some(k => pn.includes(k))){ r += parseP(o.product?.price); n++; }
    });
    return { ...c, r, n };
  }).filter(c => c.n > 0);
  const ttl = cd.reduce((s,c) => s + c.r, 0) || 1;
  $('#cat-rev').innerHTML = cd.length ? cd.map(c => `
    <div class="sb-row" onclick="openCategoryDetail('${esc(c.k)}')">
      <div class="sb-dot" style="background:${c.color};box-shadow:0 0 8px ${c.color}66"></div>
      <div class="sb-name">${c.k}</div>
      <div class="sb-bar"><div style="width:${Math.round(c.r/ttl*100)}%;background:${c.color}"></div></div>
      <div class="sb-cnt">${fmtS(c.r)}</div>
    </div>
  `).join('') : '<p style="color:var(--muted);font-size:13px;text-align:center;padding:18px">Chưa có dữ liệu</p>';
}

