function openCategoryDetail(catName){
  const catMap = {
    'Piano':  ['piano','p-45','p-125','cdp','px-s','u1','ap-270','upright','grand','mp-100'],
    'Guitar': ['f310','c40','d-28','114e','strat','les paul','grx','squier','guitar','acoustic'],
