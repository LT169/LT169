/* ══════════════════════════════════════════════════════════════════
   BOOT
   ══════════════════════════════════════════════════════════════════ */
async function boot(){
  loadLocal();
  renderSnippet();
  updateSyncLabel();
  go('dash');
  updateBadges();

  const apiKey = localStorage.getItem(CFG.LS_API);
  const binId  = localStorage.getItem(CFG.LS_BIN);

  if(apiKey && binId){
    CLOUD.apiKey = apiKey;
    CLOUD.binId  = binId;
    CLOUD.hasCloud = true;
    setCloudStatus('syncing','Đang kết nối...');
    $('#cfg-status').textContent = '✅ Đã kết nối cloud';
    $('#cfg-key-display').textContent = apiKey.slice(0,16) + '...' + apiKey.slice(-6);
    $('#cfg-bin-display').textContent = binId;
    $('#snippet-panel').style.display = 'block';
    $('#cfg-api').value = apiKey;
    $('#cfg-bin').value = binId;
    try{
      await pullFromCloud(false);
      startAutoSync();
    }catch(e){ setCloudStatus('offline','Lỗi kết nối'); }
  } else {
    setCloudStatus('local','Chỉ lưu máy này');
  }
}

document.addEventListener('keydown', e => {
  if(e.key === 'Escape' && $('#modal').classList.contains('open')) closeModal();
  if(e.key === 'Enter' && $('#modal').classList.contains('open')){
    const primary = $('#modal-box .m-ft .btn-pri') || $('#cf-yes');
    if(primary && !document.activeElement?.matches('textarea')){
      e.preventDefault();
      primary.click();
    }
  }
});

document.addEventListener('DOMContentLoaded', () => {
  boot();
  window.addEventListener('online', () => { toast('🌐 Có mạng trở lại','success'); pullFromCloud(false); });
  window.addEventListener('offline', () => toast('📴 Mất mạng','error'));
});
